FROM node:22-bookworm-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends poppler-utils libreoffice-calc tesseract-ocr tesseract-ocr-eng tesseract-ocr-fra && rm -rf /var/lib/apt/lists/*
COPY package*.json ./
COPY prisma ./prisma/
RUN npm ci
COPY . .
RUN npx prisma@6.19.3 generate
CMD ["npm", "test", "--", "--runInBand", "src/knowledge/office-extractor.spec.ts"]
