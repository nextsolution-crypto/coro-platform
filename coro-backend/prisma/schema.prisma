model RueLocalAuthorityContact {
  id String @id @default(uuid())

  localAuthorityId String
  localAuthority   RueLocalAuthority @relation(fields: [localAuthorityId], references: [id], onDelete: Cascade)

  firstName String?
  lastName  String?
  title     String?

  phone String?
  email String?

  roleDescription String?

  isPrimary   Boolean @default(false)
  isAlternate Boolean @default(false)
  isEmergency Boolean @default(false)
  is24x7      Boolean @default(false)

