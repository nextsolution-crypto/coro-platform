  isPrimary   Boolean @default(false)
  isEmergency Boolean @default(false)
  is24x7      Boolean @default(false)
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([surroundingAssetId])
}

model RueLocalAuthority {
  id String @id @default(uuid())

  facilityProfileId String
  facilityProfile   RueFacilityProfile @relation(fields: [facilityProfileId], references: [id], onDelete: Restrict)

  type RueAuthorityType

  // Identification de l'autorité ou de l'organisme.
  name String

  // Territoire ou juridiction concerné.
  jurisdiction String?

  address    String?
  city       String?
  province   String?
  postalCode String?

  publicPhone String?
  publicEmail String?
  websiteUrl  String?

  // Rôle prévu dans le PUE ou lors d'une urgence.
  roleDescription String?

  // Participation à la préparation du PUE.
