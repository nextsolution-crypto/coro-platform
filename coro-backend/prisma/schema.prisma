// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  isInternal  Boolean  @default(false)
  licenseType String   @default("ESSAI_GRATUIT")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users      User[]
  clients    Client[]
  buildings  Building[]
  projects   Project[]
  procedureOverrides ProcedureOverride[]

  feedbacks   Feedback[]
  projectTemplates ProjectTemplate[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  role      UserRole @default(OPERATOR)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyName         String?
  companyLogo         String?
  companyLogoB64      String?
  companyLogoFullB64  String?
  companyPhone        String?
  companyEmail        String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  projects  Project[]
  feedbacks   Feedback[]
  lastEditedProjects Project[] @relation("lastEditedProjects")
  createdTemplates ProjectTemplate[] @relation("createdTemplates")
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

model Client {
  id        String   @id @default(uuid())
  name      String
  email     String?
  phone     String?
  address   String?
  city      String?
  province  String?
  logoUrl      String?
  logoBase64   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  buildings Building[]
  projects  Project[]
}

model Building {
  id           String   @id @default(uuid())
  name         String
  address      String
  city         String
  province     String
  postalCode   String?
  floors       Int?
  units        Int?
  buildingType String?
  photoBase64         String?
  responsableNom      String?
  responsableTitre    String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId  String
  client    Client    @relation(fields: [clientId], references: [id])
  projects  Project[]
}

model Project {
  id           String        @id @default(uuid())
  name         String
  documentType DocumentType
  status       ProjectStatus @default(DRAFT)
  year         Int
  progress     Int           @default(0)
  configData   Json?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  lastEditedById String?
  lastEditedBy   User?    @relation("lastEditedProjects", fields: [lastEditedById], references: [id])

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId   String
  client     Client    @relation(fields: [clientId], references: [id])
  buildingId String
  building   Building  @relation(fields: [buildingId], references: [id])
  userId     String
  user       User      @relation(fields: [userId], references: [id])

  documents           Document[]
  buildingPlans       BuildingPlan[]
  module7             Module7Data?
  revisionHistory     RevisionHistory[]
  procedureOverrides  ProcedureOverride[]
  projectVersions     ProjectVersion[]
}

model RevisionHistory {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])

  date        String
  description String
  responsable String

  createdAt   DateTime @default(now())
}

enum DocumentType {
  PSI
  PMU
  PCA
  PGC
  PRA
  PUE
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  VALIDATED
  EXPORTED
  ARCHIVED
}

model Document {
  id        String         @id @default(uuid())
  title     String
  content   Json?
  status    DocumentStatus @default(DRAFT)
  version   Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

enum DocumentStatus {
  DRAFT
  IN_PROGRESS
  VALIDATED
  EXPORTED
  ARCHIVED
}

model IncidentCode {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  color       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  procedures  Procedure[]
}

model Role {
  id          String   @id @default(uuid())
  name        String
  roleCode    String   @unique
  description String?
  isStandard  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  procedures  Procedure[]
}

model Procedure {
  id            String          @id @default(uuid())
  name          String
  description   String?
  documentTypes String[]
  phase         String?
  status        ProcedureStatus @default(DRAFT)
  content       Json?
  version       Int             @default(1)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  incidentCodeId String?
  incidentCode   IncidentCode? @relation(fields: [incidentCodeId], references: [id])
  roleId         String?
  role           Role?         @relation(fields: [roleId], references: [id])
}

enum ProcedureStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model LibrarySection {
  id            String   @id @default(uuid())
  title         String
  documentTypes String[]
  order         Int      @default(0)
  content       Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BuildingPlan {
  id           String   @id @default(uuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id])

  section      PlanSection
  name         String
  description  String?
  fileBase64   String
  fileName     String
  fileSize     Int
  emissionDate String?
  revision     String?
  order        Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum PlanSection {
  IMPLANTATION
  COUPE
  OPERATION
  SECTEURS
  DIVERS
}

model Module7Data {
  id        String   @id @default(uuid())
  projectId String   @unique
  project   Project  @relation(fields: [projectId], references: [id])

  // Quarts de travail détaillés
  quartsData      Json?

  // Photos des équipements (base64)
  photosData      Json?

  // Champs complémentaires non couverts par le configurateur
  extraData       Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangelogEntry {
  id          String   @id @default(uuid())
  title       String
  description String
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ProcedureDefault {
  id        String   @id @default(uuid())
  code      String   @unique
  content   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overrides ProcedureOverride[]
}

model ProcedureOverride {
  id             String   @id @default(uuid())
  procedureId    String
  organizationId String
  projectId      String?
  content        Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  procedure    ProcedureDefault @relation(fields: [procedureId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])

  @@unique([procedureId, organizationId, projectId])
}

model Feedback {
  id             String   @id @default(uuid())
  category       String   // BUG, SUGGESTION, QUESTION, AUTRE
  message        String
  status         String   @default("NOUVEAU") // NOUVEAU, LU, EN_COURS, RESOLU
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

model ProjectVersion {
  id          String   @id @default(uuid())
  projectId   String
  versionNumber Int
  label       String?
  snapshot    Json     // Contenu complet du document à ce moment
  createdAt   DateTime @default(now())

  project     Project  @relation(fields: [projectId], references: [id])
}

model ProjectTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  documentType   String
  configData     Json?
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("createdTemplates", fields: [createdById], references: [id])
}