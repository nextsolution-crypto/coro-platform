// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                     String                  @id @default(uuid())
  name                   String
  isInternal             Boolean                 @default(false)
  licenseType            String                  @default("ESSAI_GRATUIT")
  commercialRelationship CommercialRelationship?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  // Programme de recommandation CORO
  referralCode           String?                 @unique
  // Champs PCA
  sector                 String? // Secteur d'activité
  employeeCount          Int? // Nombre d'employés
  operatingHours         String? // Heures d'opération

  users                        User[]
  clients                      Client[]
  buildings                    Building[]
  projects                     Project[]
  procedureOverrides           ProcedureOverride[]
  feedbacks                    Feedback[]
  projectTemplates             ProjectTemplate[]
  auditLogs                    AuditLog[]
  customProcedures             CustomProcedure[]
  clientUsers                  ClientUser[]
  module1Template              OrganizationModule1Template?
  bookings                     Booking[]
  files                        ProjectFile[]
  exerciseReports              ExerciseReport[]
  complianceRequirements       ComplianceRequirement[]
  complianceEvidence           ComplianceEvidence[]
  populationOperationalEvents  PopulationOperationalEvent[]
  populationEvidenceRecords    PopulationEvidenceRecord[]
  populationEvidenceManifests  PopulationEvidenceManifest[]
  populationEvidenceReports    PopulationEvidenceReport[]
  operationalReviewReports     OperationalReviewReport[]
  activityTypes                ActivityType[]
  activityTypeTaskListPolicies ActivityTypeTaskListPolicy[]
  mandateServices              ProjectMandateService[]
  mandateServiceOperations     MandateServiceOperation[]
  // Programme de recommandation
  referralsSent                Referral[]                   @relation("ReferralReferrer")
  referralReceived             Referral?                    @relation("ReferralReferred")
  referralCredits              ReferralCredit[]             @relation("ReferralCreditOrganization")
  contracts                    OrganizationContract[]
  capabilityEntitlements       CapabilityEntitlement[]
  commercialProposals          CommercialProposal[]
  convertedCommercialProspects CommercialProspect[] @relation("CommercialProspectConversion")
  meteringResults              MeteringResult[]
  commercialSimulationWorkspaces CommercialSimulationWorkspace[]
}

model User {
  id                  String              @id @default(uuid())
  email               String              @unique
  password            String
  firstName           String
  lastName            String
  role                UserRole            @default(OPERATOR)
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id])
  companyName         String?
  companyLogo         String?
  companyLogoB64      String?
  companyLogoFullB64  String?
  companyPhone        String?
  companyEmail        String?
  companyAddress      String?
  companyWebsite      String?
  companyTagline      String?
  companyLicense      String?
  title               String?
  phoneDirect         String?
  phoneMobile         String?
  certification       String?
  province            String?
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  observationsCreated ReviewObservation[] @relation("observationCreator")
  observationsTreated ReviewObservation[] @relation("observationTreater")
  capabilityEntitlementsCreated CapabilityEntitlement[] @relation("CapabilityEntitlementCreator")
  capabilityEntitlementRevisionsCreated CapabilityEntitlementRevision[] @relation("CapabilityEntitlementRevisionActor")
  commercialProspectsCreated CommercialProspect[] @relation("CommercialProspectCreator")
  commercialProspectsConverted CommercialProspect[] @relation("CommercialProspectConverter")
  commercialProposalsCreated CommercialProposal[] @relation("CommercialProposalCreator")
  commercialProposalRevisionsCreated CommercialProposalRevision[] @relation("CommercialProposalRevisionCreator")
  proposalDocumentsCreated ProposalDocument[] @relation("ProposalDocumentCreator")
  commercialSimulationWorkspacesCreated CommercialSimulationWorkspace[] @relation("CommercialSimulationWorkspaceCreator")
  commercialSimulationRunsCreated CommercialSimulationCalculationRun[] @relation("CommercialSimulationRunCreator")
  commercialSimulationConversionsCreated CommercialSimulationProposalConversion[] @relation("CommercialSimulationConversionCreator")
  commercialCostAssumptionVersionsCreated CommercialCostAssumptionVersion[] @relation("CommercialCostAssumptionVersionCreator")
  commercialValuationAssumptionVersionsCreated CommercialValuationAssumptionVersion[] @relation("CommercialValuationAssumptionVersionCreator")
  approvedProjects    Project[]           @relation("approvedProjects")
  notifications       Notification[]

  projects                  Project[]
  feedbacks                 Feedback[]
  lastEditedProjects        Project[]             @relation("lastEditedProjects")
  submittedProjects         Project[]             @relation("submittedProjects")
  createdTemplates          ProjectTemplate[]     @relation("createdTemplates")
  auditLogs                 AuditLog[]
  taskAssignees             ProjectTaskAssignee[]
  timeEntries               TaskTimeEntry[]
  projectComments           ProjectComment[]
  ownedMandates             ProjectMandate[]      @relation("mandateOwner")
  assignedTasks             ProjectTask[]         @relation("taskAssignee")
  horaireBase               Float                 @default(40)
  timeZone                  String                @default("America/Toronto")
  timeZoneVerified          Boolean               @default(false)
  workSchedules             UserWorkSchedule[]    @relation("WorkScheduleUser")
  workSchedulesVerified     UserWorkSchedule[]    @relation("WorkScheduleVerifier")
  unavailabilities          UserUnavailability[]  @relation("UnavailableUser")
  unavailabilitiesCreated   UserUnavailability[]  @relation("UnavailabilityCreator")
  unavailabilitiesCancelled UserUnavailability[]  @relation("UnavailabilityCanceller")
  timelogEntries            TimelogEntry[]
  customProcedures          CustomProcedure[]
  refreshTokens             RefreshToken[]
  trustedDevices            TrustedDevice[]
  mfaChallenge              PlatformMfaChallenge?
  adminAuditEvents          AdminAuditEvent[]
  priceBookVersionsCreated  PriceBookVersion[]    @relation("PriceBookVersionCreator")
  organizationContractsCreated OrganizationContract[]         @relation("OrganizationContractCreator")
  contractRevisionsCreated     OrganizationContractRevision[] @relation("ContractRevisionCreator")
  contractDocumentsUploaded    OrganizationContractDocument[] @relation("ContractDocumentUploader")

  resetToken       String?
  resetTokenExpiry DateTime?
  mfaCode          String?
  mfaCodeExpiry    DateTime?
  authVersion      Int       @default(1)

  bookings                         Booking[]
  bookingAssignments               BookingAssignment[]       @relation("BookingAssignee")
  bookingAssignmentsCreated        BookingAssignment[]       @relation("BookingAssignmentActor")
  uploadedFiles                    ProjectFile[]             @relation("FileUploader")
  referralsCreated                 Referral[]                @relation("ReferralCreator")
  exerciseReportsCreated           ExerciseReport[]          @relation("ExerciseReportCreator")
  exerciseReportsFinalized         ExerciseReport[]          @relation("ExerciseReportFinalizer")
  exerciseReportVersions           ExerciseReportVersion[]
  exerciseReportImportsReviewed    ExerciseReportImport[]    @relation("ExerciseReportImportReviewer")
  exerciseParticipantsValidated    ExerciseParticipant[]     @relation("ExerciseParticipantValidator")
  exerciseTimelineValidated        ExerciseTimelineEntry[]   @relation("ExerciseTimelineValidator")
  exerciseFindingsValidated        ExerciseFinding[]         @relation("ExerciseFindingValidator")
  exerciseRecommendationsValidated ExerciseRecommendation[]  @relation("ExerciseRecommendationValidator")
  exerciseActionItemsValidated     ExerciseActionItem[]      @relation("ExerciseActionItemValidator")
  mandateServicesCreated           ProjectMandateService[]   @relation("MandateServiceCreator")
  mandateServicesUpdated           ProjectMandateService[]   @relation("MandateServiceUpdater")
  mandateServicesRemoved           ProjectMandateService[]   @relation("MandateServiceRemover")
  mandateServiceOperations         MandateServiceOperation[] @relation("MandateServiceOperationCreator")
  meteringResultsCreated           MeteringResult[] @relation("MeteringResultCreator")
}

model UserWorkSchedule {
  id               String                     @id @default(uuid())
  organizationId   String
  userId           String
  user             User                       @relation("WorkScheduleUser", fields: [userId], references: [id])
  timeZone         String
  effectiveFrom    DateTime
  effectiveUntil   DateTime?
  verifiedAt       DateTime
  verifiedByUserId String
  verifiedBy       User                       @relation("WorkScheduleVerifier", fields: [verifiedByUserId], references: [id])
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt
  intervals        UserWorkScheduleInterval[]

  @@index([organizationId, userId, effectiveFrom])
}

model UserWorkScheduleInterval {
  id         String           @id @default(uuid())
  scheduleId String
  schedule   UserWorkSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  dayOfWeek  Int
  startTime  Int
  endTime    Int
  createdAt  DateTime         @default(now())

  @@index([scheduleId, dayOfWeek])
}

enum UserUnavailabilityType {
  VACATION
  SICK
  TRAINING
  TRAVEL
  ADMIN_BLOCK
  PERSONAL
  OTHER
}

model UserUnavailability {
  id                String                 @id @default(uuid())
  organizationId    String
  userId            String
  user              User                   @relation("UnavailableUser", fields: [userId], references: [id])
  startAt           DateTime
  endAt             DateTime
  allDay            Boolean                @default(false)
  localStartDate    DateTime?              @db.Date
  localEndDate      DateTime?              @db.Date
  timeZone          String
  type              UserUnavailabilityType
  privateNote       String?
  createdByUserId   String
  createdBy         User                   @relation("UnavailabilityCreator", fields: [createdByUserId], references: [id])
  cancelledAt       DateTime?
  cancelledByUserId String?
  cancelledBy       User?                  @relation("UnavailabilityCanceller", fields: [cancelledByUserId], references: [id])
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt

  @@index([organizationId, userId, startAt, endAt])
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

enum CommercialRelationship {
  DIRECT
  PARTNER
  INTERNAL
}

enum CapabilityCode {
  COMPLIANCE_OPERATIONS
  PERFORMANCE
  INCIDENT
  KNOWLEDGE
  AI
  NETWORK
  SENTINELLE
  SENTINELLE_POPULATION
  CAMPUS
}

enum CapabilityLifecycle {
  CURRENT
  FUTURE
  RETIRED
}

enum CommercialScope {
  ORGANIZATION
  CLIENT
  SITE
}

enum MeteringSourceQuality {
  CANONICAL
  DERIVED
}

enum CapabilityScopeStatus {
  ALLOWED
  NOT_ALLOWED
  UNDECIDED
}

enum PriceBookAudience {
  DIRECT
  PARTNER
}

enum PriceBookVersionStatus {
  DRAFT
  SCHEDULED
  ACTIVE
  ARCHIVED
  CANCELLED
}

enum PricingModel {
  FLAT
  PER_UNIT
  PER_SEAT
  PER_SITE
  TIERED
  USAGE
  COMPLEXITY
  CUSTOM
}

enum PriceChargeType {
  RECURRING
  ONE_TIME
}

enum BillingPeriod {
  MONTH
  YEAR
}

enum PriceMetric {
  FIXED
  HOUR
  SEAT
  SITE
  CLIENT
  USAGE_UNIT
  COMPLEXITY
}

enum TierCalculationMode {
  VOLUME
  GRADUATED
}

enum OrganizationContractStatus {
  DRAFT
  APPROVED
  SCHEDULED
  ACTIVE
  EXPIRED
  TERMINATED
  CANCELLED
}
enum ContractRevisionType {
  INITIAL
  AMENDMENT
  RENEWAL
}
enum ContractRevisionStatus {
  DRAFT
  APPROVED
  SIGNED
  CANCELLED
}
enum ContractRenewalMode {
  NONE
  MANUAL
  AUTO
}
enum ContractBillingCadence {
  MONTHLY
  QUARTERLY
  ANNUAL
}
enum ContractAdjustmentScope {
  GLOBAL
  COMPONENT
  CUSTOM_COMPONENT
}
enum ContractAdjustmentType {
  PERCENT_DISCOUNT
  FIXED_OVERRIDE
  CUSTOM_FIXED_PRICE
}
enum ContractPriceLineSource {
  CATALOG_COMPONENT
  CUSTOM_COMPONENT
  EXCLUSIVITY_FEE
}
enum ContractTerritoryType {
  ISO_COUNTRY
  ISO_SUBDIVISION
  REGION
  CUSTOM
}
enum ContractExclusivityStatus {
  AGREED
  TERMINATED
  EXPIRED
}
enum ContractCommitmentType {
  MINIMUM_SPEND
  MINIMUM_SEATS
  MINIMUM_SITES
  MINIMUM_CLIENTS
  CUSTOM
}
enum ContractCommitmentPeriod {
  MONTH
  QUARTER
  YEAR
  CONTRACT_TERM
}
enum ContractDocumentType {
  SIGNED_CONTRACT
  SIGNED_AMENDMENT
  SIGNED_RENEWAL
  SUPPORTING_DOCUMENT
}

enum EntitlementSource {
  CONTRACT
  DISTRIBUTION
  MANUAL_OVERRIDE
  TRIAL
  INTERNAL
}

enum EntitlementLifecycle {
  GRANTED
  SUSPENDED
  REVOKED
}

enum EntitlementLimitType {
  SEATS
  CLIENTS
  SITES
  USAGE
}

enum CommercialProspectStatus {
  ACTIVE
  CONVERTED
  DISQUALIFIED
}
enum CommercialProposalStatus {
  OPEN
  ACCEPTED
  REJECTED
  CANCELLED
}
enum CommercialProposalRevisionStatus {
  DRAFT
  INTERNAL_REVIEW
  READY
  SENT
  ACCEPTED
  REJECTED
  SUPERSEDED
  CANCELLED
}
enum ProposalLineSource {
  CATALOG_COMPONENT
  CUSTOM_COMPONENT
  EXCLUSIVITY_FEE
}
enum CommercialRevenueCategory {
  SAAS
  PROFESSIONAL_SERVICE
  IMPLEMENTATION
  OTHER_RECURRING
  OTHER_ONE_TIME
}
enum ProposalAdjustmentScope {
  GLOBAL
  COMPONENT
  CUSTOM_COMPONENT
}
enum ProposalAdjustmentType {
  PERCENT_DISCOUNT
  FIXED_OVERRIDE
  CUSTOM_FIXED_PRICE
}
enum ProposalInputCategory {
  QUANTITY
  COMPLEXITY
  VALUE_ANALYSIS
  COMMERCIAL_ASSUMPTION
}
enum ProposalInputValueType {
  DECIMAL
  INTEGER
  MONEY
  BOOLEAN
  TEXT
}
enum ProposalInputSource {
  DECLARED
  OBSERVED_SNAPSHOT
  MANUAL_ASSUMPTION
}
enum ProposalCalculationStatus {
  CALCULATED
  ESTIMATED
  MANUAL
  TBD
}

enum CommercialQuantityBasis {
  DECLARED
  METERED
}
enum ProposalDocumentType {
  OFFER
  ACCEPTANCE_EVIDENCE
  SUPPORTING_DOCUMENT
}
enum ProposalDocumentStatus {
  GENERATING
  FINALIZED
  FAILED
}
enum ProposalLanguage {
  FR
  EN
}

model CommercialCapability {
  id              String                  @id @default(uuid())
  code            CapabilityCode          @unique
  nameFr          String
  nameEn          String
  descriptionFr   String
  descriptionEn   String
  lifecycle       CapabilityLifecycle
  isAvailable     Boolean
  displayOrder    Int
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  scopePolicies   CapabilityScopePolicy[]
  priceComponents PriceComponent[]
  contractAdjustments ContractPricingAdjustment[]
  contractPriceSnapshots ContractPriceSnapshotLine[]
  contractExclusivityCapabilities ContractExclusivityCapability[]
  entitlements CapabilityEntitlement[]
  proposalLines ProposalLine[]
  proposalInputs ProposalInput[]
  proposalExclusivityCapabilities ProposalExclusivityCapability[]
  simulationScenarioCapabilities CommercialSimulationScenarioCapability[]
  simulationScenarioLines CommercialSimulationScenarioLine[]

  @@index([displayOrder])
  @@index([lifecycle, isAvailable])
}

model CapabilityScopePolicy {
  id           String                @id @default(uuid())
  capabilityId String
  scope        CommercialScope
  status       CapabilityScopeStatus
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  capability   CommercialCapability  @relation(fields: [capabilityId], references: [id], onDelete: Restrict)

  @@unique([capabilityId, scope])
  @@index([scope, status])
}

model PriceBook {
  id         String             @id @default(uuid())
  code       String             @unique
  name       String
  audience   PriceBookAudience
  currency   String             @db.Char(3)
  archivedAt DateTime?
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt
  versions   PriceBookVersion[]
  proposalRevisions CommercialProposalRevision[]

  @@index([audience, currency])
  @@index([archivedAt])
}

model PriceBookVersion {
  id                   String                 @id @default(uuid())
  priceBookId          String
  versionNumber        Int
  status               PriceBookVersionStatus @default(DRAFT)
  effectiveFrom        DateTime?
  effectiveUntil       DateTime?
  createdByUserId      String?
  createdByDisplayName String?
  publishedAt          DateTime?
  archivedAt           DateTime?
  cancelledAt          DateTime?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  priceBook            PriceBook              @relation(fields: [priceBookId], references: [id], onDelete: Restrict)
  createdBy            User?                  @relation("PriceBookVersionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  components           PriceComponent[]
  contractRevisions    OrganizationContractRevision[]
  proposalRevisions    CommercialProposalRevision[]
  simulationWorkspaces CommercialSimulationWorkspace[]
  simulationRuns       CommercialSimulationCalculationRun[]

  @@unique([priceBookId, versionNumber])
  @@index([priceBookId, status])
  @@index([status, effectiveFrom, effectiveUntil])
  @@index([createdByUserId])
}

model PriceComponent {
  id                 String               @id @default(uuid())
  priceBookVersionId String
  capabilityId       String
  code               String
  nameFr             String
  nameEn             String
  descriptionFr      String?
  descriptionEn      String?
  pricingModel       PricingModel
  chargeType         PriceChargeType
  revenueCategory    CommercialRevenueCategory?
  billingPeriod      BillingPeriod?
  metric             PriceMetric?
  tierMode           TierCalculationMode?
  amountMinor        BigInt?
  displayOrder       Int
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  priceBookVersion   PriceBookVersion     @relation(fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  capability         CommercialCapability @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  tiers              PriceTier[]
  contractAdjustments ContractPricingAdjustment[]
  contractSnapshots   ContractPriceSnapshotLine[]
  proposalLines       ProposalLine[]
  simulationScenarioLines CommercialSimulationScenarioLine[]

  @@unique([priceBookVersionId, code])
  @@index([priceBookVersionId, displayOrder])
  @@index([capabilityId])
  @@index([pricingModel])
}

model PriceTier {
  id               String         @id @default(uuid())
  priceComponentId String
  minimumQuantity  Decimal        @db.Decimal(20, 6)
  maximumQuantity  Decimal?       @db.Decimal(20, 6)
  amountMinor      BigInt
  displayOrder     Int
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  priceComponent   PriceComponent @relation(fields: [priceComponentId], references: [id], onDelete: Restrict)

  @@unique([priceComponentId, displayOrder])
  @@index([priceComponentId, minimumQuantity, maximumQuantity])
}

model OrganizationContract {
  id String @id @default(uuid())
  organizationId String
  reference String @unique
  title String
  status OrganizationContractStatus @default(DRAFT)
  isPrimary Boolean @default(false)
  approvedAt DateTime?
  activatedAt DateTime?
  expiredAt DateTime?
  terminatedAt DateTime?
  cancelledAt DateTime?
  lifecycleReason String?
  internalNotes String?
  lockVersion Int @default(0)
  createdByUserId String?
  createdByDisplayName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  createdBy User? @relation("OrganizationContractCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  revisions OrganizationContractRevision[]
  documents OrganizationContractDocument[]
  entitlementSources CapabilityEntitlement[]
  @@unique([id, organizationId])
  @@index([organizationId, status])
  @@index([organizationId, isPrimary, status])
  @@index([createdByUserId])
}

model OrganizationContractRevision {
  id String @id @default(uuid())
  contractId String
  revisionNumber Int
  revisionType ContractRevisionType
  status ContractRevisionStatus @default(DRAFT)
  basedOnRevisionId String?
  priceBookVersionId String
  currency String @db.Char(3)
  effectiveFrom DateTime
  effectiveUntil DateTime?
  termStartAt DateTime
  termEndAt DateTime?
  renewalMode ContractRenewalMode @default(NONE)
  renewalTermMonths Int?
  renewalNoticeDays Int?
  renewalTerms String?
  billingCadence ContractBillingCadence?
  approvedAt DateTime?
  signedAt DateTime?
  signedByName String?
  signatureReference String?
  changeSummary String?
  justification String?
  lockVersion Int @default(0)
  createdByUserId String?
  createdByDisplayName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contract OrganizationContract @relation(fields: [contractId], references: [id], onDelete: Restrict)
  basedOnRevision OrganizationContractRevision? @relation("ContractRevisionLineage", fields: [basedOnRevisionId], references: [id], onDelete: Restrict)
  derivedRevisions OrganizationContractRevision[] @relation("ContractRevisionLineage")
  priceBookVersion PriceBookVersion @relation(fields: [priceBookVersionId], references: [id], onDelete: Restrict)
  createdBy User? @relation("ContractRevisionCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)
  adjustments ContractPricingAdjustment[]
  priceLines ContractPriceSnapshotLine[]
  exclusivities ContractExclusivity[]
  commitments ContractMinimumCommitment[]
  documents OrganizationContractDocument[]
  entitlementSources CapabilityEntitlement[]
  sourceProposalRevisionId String? @unique
  sourceProposalRevision CommercialProposalRevision? @relation("ProposalContractOrigin", fields: [sourceProposalRevisionId], references: [id], onDelete: Restrict)
  @@unique([id, contractId])
  @@unique([contractId, revisionNumber])
  @@index([contractId, status, effectiveFrom, effectiveUntil])
  @@index([priceBookVersionId])
  @@index([basedOnRevisionId])
  @@index([createdByUserId])
}

model ContractPricingAdjustment {
  id String @id @default(uuid())
  contractRevisionId String
  scope ContractAdjustmentScope
  adjustmentType ContractAdjustmentType
  revenueCategory CommercialRevenueCategory?
  sourcePriceComponentId String?
  capabilityId String?
  code String?
  label String?
  discountBasisPoints Int?
  overrideAmountMinor BigInt?
  justification String
  displayOrder Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contractRevision OrganizationContractRevision @relation(fields: [contractRevisionId], references: [id], onDelete: Restrict)
  sourcePriceComponent PriceComponent? @relation(fields: [sourcePriceComponentId], references: [id], onDelete: Restrict)
  capability CommercialCapability? @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  @@unique([contractRevisionId, displayOrder])
  @@index([contractRevisionId, scope])
  @@index([sourcePriceComponentId])
  @@index([capabilityId])
}

model ContractPriceSnapshotLine {
  id String @id @default(uuid())
  contractRevisionId String
  source ContractPriceLineSource
  sourcePriceComponentId String?
  capabilityId String?
  componentCode String
  componentName String
  description String?
  pricingModel PricingModel
  chargeType PriceChargeType
  revenueCategory CommercialRevenueCategory?
  billingPeriod BillingPeriod?
  metric PriceMetric?
  tierMode TierCalculationMode?
  currency String @db.Char(3)
  catalogAmountMinor BigInt?
  contractAmountMinor BigInt?
  adjustmentSummary String?
  quantity Decimal? @db.Decimal(20, 6)
  quantityUnit String?
  catalogExtendedAmountMinor BigInt?
  contractExtendedAmountMinor BigInt?
  calculationStatus ProposalCalculationStatus?
  calculationFormula String?
  calculationExplanation String?
  internalUse Boolean?
  distributable Boolean?
  distributionLimit Decimal? @db.Decimal(20, 6)
  distributionMetric PriceMetric?
  commercialQuantityBasis CommercialQuantityBasis?
  commercialRuleCode String? @db.VarChar(100)
  commercialRuleVersion String? @db.VarChar(50)
  displayOrder Int
  createdAt DateTime @default(now())
  contractRevision OrganizationContractRevision @relation(fields: [contractRevisionId], references: [id], onDelete: Restrict)
  sourcePriceComponent PriceComponent? @relation(fields: [sourcePriceComponentId], references: [id], onDelete: Restrict)
  capability CommercialCapability? @relation(fields: [capabilityId], references: [id], onDelete: Restrict)
  tiers ContractPriceSnapshotTier[]
  exclusivityFeeFor ContractExclusivity? @relation("ContractExclusivityEconomicLine")
  entitlementSources CapabilityEntitlement[]
  @@unique([id, contractRevisionId])
  @@unique([contractRevisionId, componentCode])
  @@index([contractRevisionId, displayOrder])
  @@index([contractRevisionId, source])
  @@index([sourcePriceComponentId])
  @@index([capabilityId])
}

model ContractPriceSnapshotTier {
  id String @id @default(uuid())
  snapshotLineId String
  minimumQuantity Decimal @db.Decimal(20, 6)
  maximumQuantity Decimal? @db.Decimal(20, 6)
  catalogAmountMinor BigInt
  contractAmountMinor BigInt
  displayOrder Int
  createdAt DateTime @default(now())
  snapshotLine ContractPriceSnapshotLine @relation(fields: [snapshotLineId], references: [id], onDelete: Restrict)
  @@unique([snapshotLineId, displayOrder])
  @@index([snapshotLineId, minimumQuantity, maximumQuantity])
}

model ContractExclusivity {
  id String @id @default(uuid())
  contractRevisionId String
  territoryType ContractTerritoryType
  territoryCode String?
  territoryLabel String
  startsAt DateTime
  endsAt DateTime?
  status ContractExclusivityStatus @default(AGREED)
  hasEconomicImpact Boolean @default(false)
  economicSnapshotLineId String? @unique
  conditions String?
  renewalTerms String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  contractRevision OrganizationContractRevision @relation(fields: [contractRevisionId], references: [id], onDelete: Restrict)
  economicSnapshotLine ContractPriceSnapshotLine? @relation("ContractExclusivityEconomicLine", fields: [economicSnapshotLineId], references: [id], onDelete: Restrict)
  sectors ContractExclusivitySector[]
  capabilities ContractExclusivityCapability[]
  @@index([contractRevisionId, startsAt, endsAt])
  @@index([territoryType, territoryCode])
  @@index([status])
}

model ContractExclusivitySector {
  exclusivityId String
  sectorCode String
  sectorLabel String
  exclusivity ContractExclusivity @relation(fields: [exclusivityId], references: [id], onDelete: Restrict)
  @@id([exclusivityId, sectorCode])
  @@index([sectorCode])
}

model ContractExclusivityCapability {
  exclusivityId String
  capabilityId String
