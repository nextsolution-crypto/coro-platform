// ─── CORO SENTINELLE — Module Incident ──────────────────────────────────────

enum IncidentType {
  SMOKE_DISCOVERY // P002 — Découverte de fumée
  FIRE_ALERT // P003 — Alerte incendie (double signal)
  FIRE_ALARM // P004 — Alarme incendie générale
  GAS_LEAK // P005 — Fuite de gaz
  ACTIVE_THREAT // P011 — Menace active / confinement
  MEDICAL // P013 — Urgence médicale
  TOXIC_GAS // P014 — Gaz toxique
  SUSPICIOUS_PACKAGE // P015 — Colis suspect
  POWER_OUTAGE // P016 — Coupure de courant
  HAZMAT // P018 — Matières dangereuses
  BOMB_THREAT // P019 — Alerte à la bombe
  LITHIUM_BATTERY // P026 — Batterie lithium
  FLOODING // P024 — Inondations
  VIOLENT_WINDS // P022 — Vents violents
  OTHER // P001 — Directives générales
}

enum IncidentStatus {
  PRE_ALERT
  ACTIVE
  CONTAINED
  RESOLVED
  CANCELLED
}

enum IncidentTaskStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ─── CORO SENTINELLE — Organisation d'urgence ───────────────────────────────

enum EmergencyRoleType {
  COORDINATOR
  EPI
  ASSEMBLY_WARDEN
  SEARCHER
  EXIT_WARDEN
  PNA_ESCORT
  FIRST_AIDER
}

enum EmergencyAssignType {
  PRIMARY
  ALTERNATE
}

enum QualificationType {
  FIRST_AID_CPR
  AED
  FIRE_EXTINGUISHER
  EPI_TRAINING
  HAZMAT
  OTHER
}

// ─── CORO SENTINELLE — Gestion des occupants ────────────────────────────────

enum OccupantType {
  EMPLOYE
  VISITEUR
  CONTRACTEUR
}

enum OccupancyStatus {
  IN
  OUT
}

// ─── CORO — Programme de recommandation ────────────────────────────────────

enum ReferralStatus {
  PENDING // Recommandation enregistrée, prospect non inscrit
  REGISTERED // Prospect inscrit / organisation créée
  QUALIFIED // Prospect considéré admissible
  CONVERTED // Est devenu client payant
  REWARDED // Récompense accordée au parrain
  REJECTED // Recommandation non admissible
  CANCELLED // Recommandation annulée
}

enum ReferralSource {
  LINK // Lien ?ref=
  CODE // Code saisi manuellement
  EMAIL // Invitation envoyée par CORO
  MANUAL // Ajout manuel par un utilisateur
  ADMIN // Attribution par administrateur CORO
}

enum ReferralCreditType {
  REFERRAL_REWARD
  MANUAL_ADJUSTMENT
  REDEMPTION
  REVERSAL
}

enum ReferralCreditStatus {
  PENDING
  APPROVED
  APPLIED
  CANCELLED
}

model OccupancyRecord {
  id             String          @id @default(uuid())
  buildingId     String
  building       Building        @relation(fields: [buildingId], references: [id])
  type           OccupantType
  status         OccupancyStatus @default(IN)
  firstName      String
  lastName       String
  company        String?
  email          String?
  phone          String?
  reason         String?
  hostName       String?
  floor          String?
  qrToken        String?
  checkedInAt    DateTime        @default(now())
  checkedOutAt   DateTime?
  organizationId String
  createdAt      DateTime        @default(now())

  evacuationCheckins EvacuationCheckIn[]
  employee           BuildingEmployee?   @relation("EmployeeRecords", fields: [employeeId], references: [id])
  employeeId         String?
}

model EvacuationEvent {
  id             String    @id @default(uuid())
  buildingId     String
  building       Building  @relation(fields: [buildingId], references: [id])
  triggeredAt    DateTime  @default(now())
  triggeredBy    String?
  totalPresent   Int       @default(0)
  snapshot       Json
  status         String    @default("ACTIVE")
  resolvedAt     DateTime?
  notes          String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  checkins        EvacuationCheckIn[]
  exerciseReports ExerciseReport[]
}

model EvacuationCheckIn {
  id                String          @id @default(uuid())
  evacuationEventId String
  evacuationEvent   EvacuationEvent @relation(fields: [evacuationEventId], references: [id])
  occupantRecordId  String
  occupantRecord    OccupancyRecord @relation(fields: [occupantRecordId], references: [id])
  isAccountedFor    Boolean         @default(false)
  checkedAt         DateTime?
  checkedBy         String?
  createdAt         DateTime        @default(now())
}

model BuildingKioskToken {
  id         String   @id @default(uuid())
  buildingId String   @unique
  building   Building @relation(fields: [buildingId], references: [id])
  token      String   @unique @default(uuid())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// Jeton dédié au pont IoT relié au panneau d'alarme incendie (PAI) du bâtiment.
// Distinct du BuildingKioskToken par principe de moindre privilège : la fuite
// d'un des deux jetons ne compromet pas l'autre usage.
model BuildingAlarmToken {
  id         String   @id @default(uuid())
  buildingId String   @unique
  building   Building @relation(fields: [buildingId], references: [id])
  token      String   @unique @default(uuid())
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model BuildingEmployee {
  id             String   @id @default(uuid())
  buildingId     String
  building       Building @relation(fields: [buildingId], references: [id])
  firstName      String
  lastName       String
  poste          String?
  email          String?
  phone          String?
  qrToken        String   @unique @default(uuid())
  pin            String?
  isActive       Boolean  @default(true)
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  occupancyRecords  OccupancyRecord[]       @relation("EmployeeRecords")
  emergencyRoles    EmployeeEmergencyRole[]
  qualifications    EmployeeQualification[]
  isEmergencyMember Boolean                 @default(false)
  smsConsent        Boolean                 @default(false)
  incidentTasks     IncidentTask[]
}

model EmployeeEmergencyRole {
  id         String              @id @default(uuid())
  employeeId String
  employee   BuildingEmployee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  buildingId String
  building   Building            @relation(fields: [buildingId], references: [id], onDelete: Cascade)
  role       EmergencyRoleType
  assignType EmergencyAssignType @default(PRIMARY)
  priority   Int                 @default(1)
  zone       String?
  validUntil DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
}

model EmployeeQualification {
  id          String            @id @default(uuid())
  employeeId  String
  employee    BuildingEmployee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        QualificationType
  certifiedAt DateTime?
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime          @default(now())
}

model IncidentEvent {
  id                   String         @id @default(uuid())
  buildingId           String
  building             Building       @relation(fields: [buildingId], references: [id])
  organizationId       String
  type                 IncidentType
  status               IncidentStatus @default(ACTIVE)
  triggeredAt          DateTime       @default(now())
  triggeredBy          String // Nom de la personne qui a déclenché
  description          String?
  occupantsSnapshot    Json // Snapshot des occupants au moment du déclenchement
  teamSnapshot         Json // Snapshot de l'équipe mobilisable au moment du déclenchement
  procedureCode        String? // Code de la procédure liée (ex: P003)
  procedureSnapshot    Json? // Étapes ROLE-CU capturées au déclenchement
  assemblyPoint        String? // Point de rassemblement récupéré du configData PMU
  interventionSheet    Json? // Fiche d'intervention figée au déclenchement (accès QR temporaire)
  publicAccessToken    String?        @unique // Jeton d'accès public à la fiche — valide tant que isActive
  publicAccessCount    Int            @default(0) // Nombre de consultations de la fiche via le lien public
  publicAccessLastAt   DateTime? // Dernière consultation de la fiche via le lien public
  containedAt          DateTime?
  resolvedAt           DateTime?
  closingNotes         String?
  rexWentWell          String? // Ce qui a bien fonctionné
  rexToImprove         String? // Points à améliorer
  rexRecommendations   String? // Recommandations
  rexCorrectiveActions String? // Actions correctives
  rexCompletedAt       DateTime? // Date de finalisation du REX
  isActive             Boolean        @default(true)
  isExercise           Boolean        @default(false)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  tasks                       IncidentTask[]
  logs                        IncidentLog[]
  exerciseReports             ExerciseReport[]
  correctiveActions           CorrectiveAction[]
  populationAlerts            PopulationAlert[]
  populationOperationalEvents PopulationOperationalEvent[]
}

model PopulationOperationalEvent {
  id String @id @default(uuid())

  // Portée locataire explicite, même si elle peut être dérivée du programme.
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  programId String
  program   PopulationProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  emergencyScenarioId String
  emergencyScenario   RueEmergencyScenario @relation(fields: [emergencyScenarioId], references: [id], onDelete: Restrict)

  // Un incident CORO peut encadrer plusieurs événements Population historiques.
  // Le rattachement reste facultatif afin que Population fonctionne seul.
  incidentEventId String?
  incidentEvent   IncidentEvent? @relation(fields: [incidentEventId], references: [id], onDelete: SetNull)

  status PopulationOperationalEventStatus @default(ACTIVE)

  // Prochaine séquence à attribuer sous verrou transactionnel.
  // La communication initiale utilise toujours la séquence 1.
  nextSequence Int @default(2)

  startedAt     DateTime      @default(now())
  startedByType CoroActorType
  startedById   String

  endedAt     DateTime?
  endedByType CoroActorType?
  endedById   String?
  closeReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  alerts            PopulationAlert[]
  evidenceRecords   PopulationEvidenceRecord[]
  evidenceManifests PopulationEvidenceManifest[]
  evidenceReports   PopulationEvidenceReport[]

  @@index([organizationId])
  @@index([programId])
  @@index([emergencyScenarioId])
  @@index([incidentEventId])
  @@index([status])
  @@index([startedAt])
  @@index([organizationId, programId])
}

model PopulationEvidenceRecord {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  programId String
  program   PopulationProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  operationalEventId String
  operationalEvent   PopulationOperationalEvent @relation(fields: [operationalEventId], references: [id], onDelete: Restrict)

  reference     String                   @unique @default(dbgenerated("population_evidence_reference()"))
  schemaVersion String
  version       Int                      @default(1)
  status        PopulationEvidenceStatus @default(FINALIZED)

  generatedAt     DateTime      @default(now())
  generatedByType CoroActorType
  generatedById   String
  finalizedAt     DateTime      @default(now())
  finalizedByType CoroActorType
  finalizedById   String

  snapshot       Json
  snapshotSha256 String

  supersedesId String?                      @unique
  supersedes   PopulationEvidenceRecord?    @relation("PopulationEvidenceSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy PopulationEvidenceRecord?    @relation("PopulationEvidenceSupersession")
  manifests    PopulationEvidenceManifest[]
  reports      PopulationEvidenceReport[]
  operationalReviews OperationalReview[]

  createdAt DateTime @default(now())

  @@unique([operationalEventId, version])
  @@index([organizationId, buildingId])
  @@index([programId])
  @@index([status])
  @@index([createdAt])
}

model PopulationEvidenceManifest {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  buildingId String
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  programId String
  program   PopulationProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  operationalEventId String
  operationalEvent   PopulationOperationalEvent @relation(fields: [operationalEventId], references: [id], onDelete: Restrict)

  evidenceRecordId String
  evidenceRecord   PopulationEvidenceRecord @relation(fields: [evidenceRecordId], references: [id], onDelete: Restrict)

  schemaVersion String
  version       Int    @default(1)

  generatedAt     DateTime      @default(now())
  generatedByType CoroActorType
  generatedById   String

  manifest       Json
  manifestSha256 String

  createdAt DateTime @default(now())

  reports PopulationEvidenceReport[]

  @@unique([evidenceRecordId, version])
  @@index([organizationId, buildingId])
  @@index([programId])
  @@index([operationalEventId])
  @@index([createdAt])
}

model PopulationEvidenceReport {
  id String @id @default(uuid())

  organizationId     String
  organization       Organization               @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  buildingId         String
  building           Building                   @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  programId          String
  program            PopulationProgram          @relation(fields: [programId], references: [id], onDelete: Restrict)
  operationalEventId String
  operationalEvent   PopulationOperationalEvent @relation(fields: [operationalEventId], references: [id], onDelete: Restrict)
  evidenceRecordId   String
  evidenceRecord     PopulationEvidenceRecord   @relation(fields: [evidenceRecordId], references: [id], onDelete: Restrict)
  manifestId         String
  manifest           PopulationEvidenceManifest @relation(fields: [manifestId], references: [id], onDelete: Restrict)

  version  Int                            @default(1)
  format   String                         @default("PDF")
  language String                         @default("FR")
  status   PopulationEvidenceReportStatus @default(GENERATING)

  generationStartedAt  DateTime      @default(now())
  generationLeaseUntil DateTime
  generatedAt          DateTime
  generatedByType      CoroActorType
  generatedById        String
  generatorVersion     String

  storageKey   String    @unique
  fileSize     Int?
  reportSha256 String?
  finalizedAt  DateTime?
  createdAt    DateTime  @default(now())

  @@unique([evidenceRecordId, version, language, format])
  @@index([organizationId, buildingId])
  @@index([programId])
  @@index([operationalEventId])
  @@index([status, generationLeaseUntil])
}

enum PopulationEvidenceStatus {
  FINALIZED
  SUPERSEDED
}

enum PopulationEvidenceReportStatus {
  GENERATING
  FINALIZED
}

model IncidentTask {
  id                String             @id @default(uuid())
  incidentEventId   String
  incidentEvent     IncidentEvent      @relation(fields: [incidentEventId], references: [id], onDelete: Cascade)
  employeeId        String?
  employee          BuildingEmployee?  @relation(fields: [employeeId], references: [id])
  role              EmergencyRoleType
  title             String
  description       String?
  stepId            String? // ID de l'étape dans la procédure CORO
  stepText          String? // Texte complet de l'étape (pour affichage offline)
  stepOrder         Int                @default(0)
  isCoordinatorStep Boolean            @default(false)
  status            IncidentTaskStatus @default(PENDING)
  ackToken          String?            @unique
  notifiedAt        DateTime?
  acknowledgedAt    DateTime?
  completedAt       DateTime?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
}

model IncidentLog {
  id              String        @id @default(uuid())
  incidentEventId String
  incidentEvent   IncidentEvent @relation(fields: [incidentEventId], references: [id], onDelete: Cascade)
  timestamp       DateTime      @default(now())
  action          String
  actor           String?
  details         String?
  isAutomatic     Boolean       @default(true)
}

model ResilienceSnapshot {
  id             String   @id @default(uuid())
  buildingId     String
  building       Building @relation(fields: [buildingId], references: [id])
  organizationId String
  score          Int
  status         String // READY | REDUCED | CRITICAL
  rolesScore     Int
  qualScore      Int
  plansScore     Int
  exercisesScore Int
