enum RueSurroundingAssetType {
  HOSPITAL
  SCHOOL
  DAYCARE
  SENIORS_RESIDENCE
  RESIDENTIAL_BUILDING
  COMMERCIAL_BUILDING
  INDUSTRIAL_BUILDING
  HIGHWAY
  PUBLIC_TRANSIT
  PARK
  FOREST
  WILDLIFE_HABITAT
  WATER_SOURCE
  WATER_BODY
  OTHER
