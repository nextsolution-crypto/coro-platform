model RueRegulatedSubstance {
  id String @id @default(uuid())

  // Position officielle dans l'annexe 1 du RUE.
  schedulePart Int
  scheduleItem Int

  // Identification réglementaire.
  casNumber String
  nameFR    String
  nameEN    String?

  // Numéros UN publiés à titre opérationnel lorsqu'applicables.
  // Une substance peut être associée à plus d'un numéro UN.
  unNumbers String[] @default([])

  // Valeurs de l'annexe 1 du RUE.
  minimumConcentrationPercent Decimal @db.Decimal(10, 4)
  minimumQuantityTonnes       Decimal @db.Decimal(14, 6)
  hazardCategory              String

  // Gestion du référentiel CORO.
  isActive          Boolean       @default(true)
  regulatorySource  String?
  regulatoryVersion String?
  source            RueDataSource @default(GOVERNMENT_REFERENCE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  facilitySubstances RueFacilitySubstance[]

  @@unique([schedulePart, scheduleItem])
  @@index([casNumber])
  @@index([nameFR])
  @@index([hazardCategory])
}

model RueFacilitySubstance {
  id String @id @default(uuid())

  facilityProfileId String
  facilityProfile   RueFacilityProfile @relation(fields: [facilityProfileId], references: [id], onDelete: Restrict)

  regulatedSubstanceId String
  regulatedSubstance   RueRegulatedSubstance @relation(fields: [regulatedSubstanceId], references: [id], onDelete: Restrict)

  // Données agrégées pour cette substance à l'échelle de l'installation.
  concentrationPercent  Decimal? @db.Decimal(10, 4)
  maximumQuantityTonnes Decimal? @db.Decimal(14, 6)

  // Indique qu'une partie de la substance peut être présente hors
  // d'un système de réservoirs. Cette information intervient notamment
  // dans l'évaluation réglementaire et la préparation du PUE.
  hasQuantityOutsideContainerSystem Boolean @default(false)

  // Informations complémentaires pouvant être utiles au calcul,
  // à la validation réglementaire ou au futur PUE.
  notes String?

  // Provenance et validation de la donnée.
  source          RueDataSource  @default(MANUAL)
  sourceReference String?
  validatedAt     DateTime?
  validatedByType CoroActorType?
  validatedById   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Systèmes physiques dans lesquels cette substance est présente.
  containerSystems RueFacilityContainerSystem[]

  emergencyScenarios RueEmergencyScenario[]

  @@unique([facilityProfileId, regulatedSubstanceId])
  @@index([facilityProfileId])
  @@index([regulatedSubstanceId])
}

model RueFacilityContainerSystem {
  id String @id @default(uuid())

  facilitySubstanceId String
  facilitySubstance   RueFacilitySubstance @relation(fields: [facilitySubstanceId], references: [id], onDelete: Restrict)

  // Identification opérationnelle du système.
  // Ex. R-101, Réservoir ammoniac extérieur,
  // Circuit de réfrigération principal.
  code String?
  name String

  // Capacité physique maximale du système en tonnes.
  // Il s'agit de la capacité du système, distincte de la quantité
  // effectivement ou normalement présente.
  maximumCapacityTonnes Decimal @db.Decimal(14, 6)

  // Quantité maximale prévue dans ce système lorsqu'elle est connue.
  maximumExpectedQuantityTonnes Decimal? @db.Decimal(14, 6)

  // Localisation et description utiles au PUE et aux premiers répondants.
  locationDescription  String?
  containerDescription String?
  processDescription   String?

  // Coordonnées facultatives permettant de positionner précisément
  // le système sur la carte opérationnelle.
  latitude  Float?
  longitude Float?

  // Provenance et validation.
  source          RueDataSource @default(MANUAL)
  sourceReference String?

  validatedAt     DateTime?
  validatedByType CoroActorType?
  validatedById   String?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([facilitySubstanceId])
  @@index([isActive])
}

model RueEmergencyScenario {
  id String @id @default(uuid())

  facilityProfileId String
  facilityProfile   RueFacilityProfile @relation(fields: [facilityProfileId], references: [id], onDelete: Restrict)

  // Substance du site principalement associée au scénario.
  facilitySubstanceId String?
  facilitySubstance   RueFacilitySubstance? @relation(fields: [facilitySubstanceId], references: [id], onDelete: SetNull)

  // Identification du scénario.
  nameFR      String
  nameEN      String?
  description String?

  type RueScenarioType @default(OTHER)

  // Exemples : fuite, rupture, incendie, explosion, rejet toxique.
  eventType String?

  // Hypothèses et conséquences déterminées dans l'analyse de risques.
  releaseDescription String?
  potentialEffects   String?

  // Distance réglementaire/modélisée jusqu'au point le plus éloigné
  // susceptible d'être touché.
  impactDistanceKm Float?

  // Méthode ayant servi à déterminer cette distance.
  // Ex. logiciel de modélisation, étude d'ingénierie, méthode reconnue.
  impactMethod String?

  // Action de protection normalement associée au scénario.
  defaultProtectiveAction RueProtectiveAction?

  // Instructions préparées pour une éventuelle communication publique.
  publicInstructionFR String?
  publicInstructionEN String?

  // Provenance et validation.
  source          RueDataSource  @default(MANUAL)
  sourceReference String?
  validatedAt     DateTime?
  validatedByType CoroActorType?
  validatedById   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  impactZones RueImpactZone[]

  // Alertes Population ayant utilisé ce scénario comme contexte source.
  // La relation peut ensuite être détachée sans perdre l'historique,
  // puisque l'alerte conserve son propre snapshot.
  populationAlerts            PopulationAlert[]
  populationOperationalEvents PopulationOperationalEvent[]

  // Mesures prévues pour prévenir, se préparer, intervenir
  // et se rétablir relativement à ce scénario.
  emergencyMeasures RueEmergencyMeasure[]

  @@index([facilityProfileId])
  @@index([facilitySubstanceId])
  @@index([type])
}

model RueEmergencyMeasure {
  id String @id @default(uuid())

  scenarioId String
  scenario   RueEmergencyScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  // Pilier réglementaire auquel appartient la mesure.
  phase RueEmergencyMeasurePhase

  // Identification de la mesure.
  titleFR String
  titleEN String?

  descriptionFR String?
  descriptionEN String?

  // Ordre d'affichage et d'exécution lorsque pertinent.
  sortOrder Int @default(0)

  // Responsabilité opérationnelle.
  // On conserve ici un titre/fonction plutôt qu'une personne nominative,
  // afin que le PUE reste valide malgré les changements de personnel.
  responsiblePosition String?

  // Une mesure peut être une action planifiée ou une capacité permanente.
  isRequired Boolean @default(true)

  // Référence vers une procédure, une instruction, une norme,
  // une étude ou une autre source documentaire.
  sourceReference String?

  // Provenance et validation.
  source          RueDataSource  @default(MANUAL)
  validatedAt     DateTime?
  validatedByType CoroActorType?
  validatedById   String?

  notes String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([scenarioId])
  @@index([phase])
  @@index([scenarioId, phase])
}

model RueImpactZone {
  id String @id @default(uuid())

  scenarioId String
  scenario   RueEmergencyScenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  // Identification opérationnelle.
  code   String
  nameFR String
  nameEN String?

  description String?

  // Géométrie de la zone.
  //
  // Prévue pour recevoir du GeoJSON Polygon ou MultiPolygon.
  // On ne limite donc pas CORO à un simple rayon autour de l'installation.
  geometry Json?

  // Distance maximale associée à cette zone lorsqu'elle est pertinente.
  maxDistanceKm Float?

  // Action de protection recommandée dans cette zone.
  protectiveAction RueProtectiveAction?

  instructionFR String?
  instructionEN String?

  // Méthode/source utilisée pour définir cette zone.
  determinationMethod String?
  sourceReference     String?
  source              RueDataSource @default(MANUAL)

  validatedAt     DateTime?
  validatedByType CoroActorType?
  validatedById   String?

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  populationAlertZones PopulationAlertZone[]

  @@unique([scenarioId, code])
  @@index([scenarioId])
}

model RueSurroundingAsset {
