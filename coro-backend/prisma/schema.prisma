  recurringMonthlyCadenceMinor BigInt
  recurringAnnualCadenceMinor  BigInt
  monthlyRecurringEquivalentMinor BigInt
  annualRecurringEquivalentMinor BigInt
  estimatedUsageTotalMinor     BigInt
  firstYearCommitmentMinor     BigInt
  firstYearIncludesEstimate    Boolean
  createdAt                    DateTime @default(now())
  run                          CommercialSimulationCalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model CommercialSimulationCostResult {
  id                           String @id @default(uuid())
  runId                        String @unique
  currency                     String @db.Char(3)
  oneTimeDirectCostMinor       BigInt
  recurringMonthlyCostMinor    BigInt
  recurringAnnualCostMinor     BigInt
  variableEstimatedCostMinor   BigInt
  firstYearCostMinor           BigInt
  createdAt                    DateTime @default(now())
  run                          CommercialSimulationCalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
}

model CommercialSimulationValueResult {
  id                           String @id @default(uuid())
  runId                        String
  capabilityCode               CapabilityCode?
  methodologyCode              String @db.VarChar(100)
  methodologyVersion           String @db.VarChar(50)
  status                       CommercialSimulationResultStatus
  createdAt                    DateTime @default(now())
  run                          CommercialSimulationCalculationRun @relation(fields: [runId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  metrics                      CommercialSimulationValueMetric[]
  @@unique([runId, methodologyCode, capabilityCode])
}

model CommercialSimulationValueMetric {
  id                           String @id @default(uuid())
  valueResultId                String
  metricCode                   String @db.VarChar(100)
  metricVersion                String @db.VarChar(50)
  valueType                    CommercialSimulationValueType
  decimalValue                 Decimal? @db.Decimal(20, 6)
  integerValue                 BigInt?
  moneyMinorValue              BigInt?
  booleanValue                 Boolean?
  textValue                    String?
  currency                     String? @db.Char(3)
  unit                         String? @db.VarChar(50)
  customerVisible              Boolean @default(false)
  createdAt                    DateTime @default(now())
  valueResult                  CommercialSimulationValueResult @relation(fields: [valueResultId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([valueResultId, metricCode])
}

model CommercialSimulationProposalConversion {
  id                           String @id @default(uuid())
  workspaceId                  String
  scenarioId                   String
  calculationRunId             String @unique
  proposalId                   String @unique
  proposalRevisionId           String @unique
  convertedByUserId            String?
  convertedAt                  DateTime @default(now())
  workspace                    CommercialSimulationWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  scenario                     CommercialSimulationScenario @relation(fields: [scenarioId, workspaceId], references: [id, workspaceId], onDelete: Restrict, onUpdate: Restrict)
  calculationRun               CommercialSimulationCalculationRun @relation(fields: [calculationRunId, scenarioId], references: [id, scenarioId], onDelete: Restrict, onUpdate: Restrict)
  proposal                     CommercialProposal @relation(fields: [proposalId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  proposalRevision             CommercialProposalRevision @relation(fields: [proposalRevisionId, proposalId], references: [id, proposalId], onDelete: Restrict, onUpdate: Restrict)
  convertedBy                  User? @relation("CommercialSimulationConversionCreator", fields: [convertedByUserId], references: [id], onDelete: SetNull, onUpdate: Restrict)
  @@index([workspaceId, convertedAt])
  @@unique([calculationRunId, scenarioId])
  @@unique([proposalRevisionId, proposalId])
}
