enum ExerciseReportStatus {
  DRAFT
  FINALIZING
  PUBLISHED
  PUBLICATION_FAILED
  ARCHIVED
}

enum ExerciseReportType {
  TABLETOP
  EVACUATION
}

enum ExerciseDataSource {
  CORO
  SENTINELLE
  REX
  DOCX_EXTRACTED
  AI_INFERRED
  MANUAL
}

enum ExerciseFindingType {
  POSITIVE
  GAP
}

enum ExerciseTimelineEntryType {
  INPUT
  RESPONSE
}

model ExerciseReport {
  id                String               @id @default(uuid())
  organizationId    String
  organization      Organization         @relation(fields: [organizationId], references: [id])
  projectId         String
  project           Project              @relation(fields: [projectId], references: [id])
  activityId        String               @unique
  activity          ProjectActivity      @relation(fields: [activityId], references: [id], onDelete: Restrict)
  clientId          String
  client            Client               @relation(fields: [clientId], references: [id])
  buildingId        String
  building          Building             @relation(fields: [buildingId], references: [id])
  bookingId         String?
  booking           Booking?             @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  incidentEventId   String?
  incidentEvent     IncidentEvent?       @relation(fields: [incidentEventId], references: [id], onDelete: SetNull)
  evacuationEventId String?
  evacuationEvent   EvacuationEvent?     @relation(fields: [evacuationEventId], references: [id], onDelete: SetNull)
  officialFileId    String?              @unique
  officialFile      ProjectFile?         @relation("ExerciseReportOfficialFile", fields: [officialFileId], references: [id], onDelete: SetNull)
  type              ExerciseReportType
  status            ExerciseReportStatus @default(DRAFT)
  activityLabel     String
  scheduledAt       DateTime?
  occurredAt        DateTime?
  startedAt         DateTime?
  durationMinutes   Int?
  zones             String[]
  mandateName       String?
  providerName      String?
  adviserName       String?
  buildingName      String
  buildingAddress   String
  level             String?
  difficulty        String?
  scenario          String?
  positiveIntro     String?
  globalRating      String?
  summaryTitle      String?
  conclusion        String?
  preparedBy        String?
  recipient         String?
  conclusionDate    DateTime?
  fieldProvenance   Json?
  createdById       String
  createdBy         User                 @relation("ExerciseReportCreator", fields: [createdById], references: [id])
  finalizedById     String?
  finalizedBy       User?                @relation("ExerciseReportFinalizer", fields: [finalizedById], references: [id])
  finalizedAt       DateTime?
  publishedAt       DateTime?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  participants       ExerciseParticipant[]
  timelineEntries    ExerciseTimelineEntry[]
  findings           ExerciseFinding[]
  recommendations    ExerciseRecommendation[]
  actionItems        ExerciseActionItem[]
  versions           ExerciseReportVersion[]
  imports            ExerciseReportImport[]
  correctiveActions  CorrectiveAction[]
  complianceEvidence ComplianceEvidence[]

  @@index([organizationId])
  @@index([projectId])
  @@index([buildingId])
  @@index([bookingId])
  @@index([incidentEventId])
  @@index([evacuationEventId])
  @@index([status])
}

model ExerciseParticipant {
  id              String             @id @default(uuid())
  key             String
  reportId        String
  report          ExerciseReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  name            String
  status          String?
  simulatedRole   String?
  teamFunction    String?
  observations    String?
  order           Int                @default(0)
  source          ExerciseDataSource @default(MANUAL)
  confidence      Float?
  sourceRef       String?
  validatedById   String?
  validatedBy     User?              @relation("ExerciseParticipantValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt     DateTime?
  isHumanModified Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([reportId, key])
  @@index([reportId])
}

model ExerciseTimelineEntry {
  id              String                    @id @default(uuid())
  key             String
  reportId        String
  report          ExerciseReport            @relation(fields: [reportId], references: [id], onDelete: Cascade)
  occurredAt      DateTime?
  type            ExerciseTimelineEntryType
  event           String
  description     String?
  order           Int                       @default(0)
  source          ExerciseDataSource        @default(MANUAL)
  confidence      Float?
  sourceRef       String?
  validatedById   String?
  validatedBy     User?                     @relation("ExerciseTimelineValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt     DateTime?
  isHumanModified Boolean                   @default(false)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@unique([reportId, key])
  @@index([reportId])
}

model ExerciseFinding {
  id              String              @id @default(uuid())
  key             String
  reportId        String
  report          ExerciseReport      @relation(fields: [reportId], references: [id], onDelete: Cascade)
  type            ExerciseFindingType
  title           String?
  description     String
  priority        String?
  impact          String?
  order           Int                 @default(0)
  source          ExerciseDataSource  @default(MANUAL)
  confidence      Float?
  sourceRef       String?
  validatedById   String?
  validatedBy     User?               @relation("ExerciseFindingValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt     DateTime?
  isHumanModified Boolean             @default(false)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  recommendations   ExerciseRecommendation[]
  actionItems       ExerciseActionItem[]
  correctiveActions CorrectiveAction[]

  @@unique([reportId, key])
  @@index([reportId])
}

model ExerciseRecommendation {
  id              String             @id @default(uuid())
  key             String
  reportId        String
  report          ExerciseReport     @relation(fields: [reportId], references: [id], onDelete: Cascade)
  findingId       String
  finding         ExerciseFinding    @relation(fields: [findingId], references: [id], onDelete: Cascade)
  text            String
  priority        String?
  order           Int                @default(0)
  source          ExerciseDataSource @default(MANUAL)
  confidence      Float?
  sourceRef       String?
  validatedById   String?
  validatedBy     User?              @relation("ExerciseRecommendationValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt     DateTime?
  isHumanModified Boolean            @default(false)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  actionItems       ExerciseActionItem[]
  correctiveActions CorrectiveAction[]

  @@unique([reportId, key])
  @@index([reportId])
  @@index([findingId])
}

model ExerciseActionItem {
  id               String                  @id @default(uuid())
  key              String
  reportId         String
  report           ExerciseReport          @relation(fields: [reportId], references: [id], onDelete: Cascade)
  findingId        String?
  finding          ExerciseFinding?        @relation(fields: [findingId], references: [id], onDelete: SetNull)
  recommendationId String?
  recommendation   ExerciseRecommendation? @relation(fields: [recommendationId], references: [id], onDelete: SetNull)
  correctiveAction CorrectiveAction?
  title            String
  description      String?
  assignedTo       String?
  dueDate          DateTime?
  priority         String?
  order            Int                     @default(0)
  source           ExerciseDataSource      @default(MANUAL)
  confidence       Float?
  sourceRef        String?
  validatedById    String?
  validatedBy      User?                   @relation("ExerciseActionItemValidator", fields: [validatedById], references: [id], onDelete: SetNull)
  validatedAt      DateTime?
  isHumanModified  Boolean                 @default(false)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([reportId, key])
  @@index([reportId])
  @@index([findingId])
  @@index([recommendationId])
}

model ExerciseReportVersion {
  id            String         @id @default(uuid())
  reportId      String
  report        ExerciseReport @relation(fields: [reportId], references: [id], onDelete: Restrict)
  versionNumber Int
  snapshot      Json
  createdById   String
  createdBy     User           @relation(fields: [createdById], references: [id])
  createdAt     DateTime       @default(now())

  @@unique([reportId, versionNumber])
  @@index([reportId])
}

enum ExerciseReportImportStatus {
  PENDING
  EXTRACTED
  ANALYZED
  REVIEWED
  FAILED
}

model ExerciseReportImport {
  id             String                     @id @default(uuid())
  reportId       String
  report         ExerciseReport             @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName       String
  storageKey     String?
  extractedText  String?
  structuredData Json?
  status         ExerciseReportImportStatus @default(PENDING)
  schemaVersion  String?
  errorMessage   String?
  reviewedById   String?
  reviewedBy     User?                      @relation("ExerciseReportImportReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([reportId])
}

enum ComplianceRequirementType {
  EXERCISE
  TRAINING
  DOCUMENT
  QUALIFICATION
  OTHER
}

enum ComplianceRequirementScope {
  GLOBAL
  ORGANIZATION
}

enum ComplianceEvidenceSourceType {
  EXERCISE_REPORT
  TRAINING_RECORD
  PROJECT_DOCUMENT
  EMPLOYEE_QUALIFICATION
  MANUAL
}

enum ComplianceEvidenceStatus {
  PENDING
  VALID
  EXPIRED
  REVOKED
}

model ComplianceRequirement {
  id                  String                     @id @default(uuid())
  scope               ComplianceRequirementScope
  scopeKey            String
  organizationId      String?
  organization        Organization?              @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  code                String
  name                String
  description         String?
  type                ComplianceRequirementType
  defaultValidityDays Int?
  isActive            Boolean                    @default(true)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  buildingRequirements BuildingRequirement[]
  evidence             ComplianceEvidence[]

  @@unique([scopeKey, code])
  @@index([type])
}

model BuildingRequirement {
  id             String                @id @default(uuid())
  buildingId     String
  building       Building              @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  requirementId  String
  requirement    ComplianceRequirement @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  isRequired     Boolean               @default(true)
  validityDays   Int?
  effectiveFrom  DateTime?
  effectiveUntil DateTime?
  configuration  Json?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt

  @@unique([buildingId, requirementId])
  @@index([requirementId])
}

model ComplianceEvidence {
  id               String                       @id @default(uuid())
  organizationId   String
  organization     Organization                 @relation(fields: [organizationId], references: [id])
  buildingId       String
  building         Building                     @relation(fields: [buildingId], references: [id], onDelete: Restrict)
  requirementId    String
  requirement      ComplianceRequirement        @relation(fields: [requirementId], references: [id])
  sourceType       ComplianceEvidenceSourceType
  sourceRecordId   String
  sourceVersion    String?
  sourceHash       String?
  exerciseReportId String?
  exerciseReport   ExerciseReport?              @relation(fields: [exerciseReportId], references: [id], onDelete: SetNull)
  occurredAt       DateTime
  expiresAt        DateTime?
  status           ComplianceEvidenceStatus     @default(PENDING)
  metadata         Json?
  createdAt        DateTime                     @default(now())
  updatedAt        DateTime                     @updatedAt

  @@unique([requirementId, sourceType, sourceRecordId])
  @@index([organizationId])
  @@index([buildingId])
  @@index([requirementId])
  @@index([exerciseReportId])
}

model CorrectiveAction {
  id             String    @id @default(uuid())
  organizationId String
  buildingId     String?
  incidentId     String?
  category       String // ROLES | QUALIFICATIONS | PLANS | EXERCISES | INCIDENTS | GENERAL
  title          String
  description    String?
  status         String    @default("PLANNED") // PLANNED | IN_PROGRESS | COMPLETED | CANCELLED
  priority       String    @default("WARNING") // CRITICAL | WARNING | INFO
  assignedTo     String?
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  building               Building?               @relation(fields: [buildingId], references: [id], onDelete: SetNull)
  incident               IncidentEvent?          @relation(fields: [incidentId], references: [id], onDelete: SetNull)
  exerciseReport         ExerciseReport?         @relation(fields: [exerciseReportId], references: [id], onDelete: SetNull)
  exerciseReportId       String?
  sourceFinding          ExerciseFinding?        @relation(fields: [sourceFindingId], references: [id], onDelete: SetNull)
  sourceFindingId        String?
  sourceRecommendation   ExerciseRecommendation? @relation(fields: [sourceRecommendationId], references: [id], onDelete: SetNull)
  sourceRecommendationId String?
  exerciseActionItemId   String?                 @unique
  actionItem             ExerciseActionItem?     @relation(fields: [exerciseActionItemId], references: [id], onDelete: SetNull)

  @@index([organizationId])
  @@index([buildingId])
  @@index([incidentId])
  @@index([exerciseReportId])
}

model OperationalReview {
  id String @id @default(uuid())
  organizationId String
  reference String @unique @default(dbgenerated("operational_review_reference()"))
  version Int @default(1)
  status OperationalReviewStatus @default(DRAFT)
  confidentiality OperationalReviewConfidentiality @default(RESTRICTED)
  title String
  summary String?
  buildingId String?
  projectId String?
  populationOperationalEventId String?
  populationEvidenceRecordId String?
  populationEvidenceRecord PopulationEvidenceRecord? @relation(fields: [populationEvidenceRecordId], references: [id], onDelete: Restrict)
  incidentEventId String?
  exerciseReportId String?
  createdByType CoroActorType
  createdById String
  submittedAt DateTime?
  submittedByType CoroActorType?
  submittedById String?
  finalizedAt DateTime?
  finalizedByType CoroActorType?
  finalizedById String?
  supersedesId String? @unique
  supersedes OperationalReview? @relation("OperationalReviewSupersession", fields: [supersedesId], references: [id], onDelete: Restrict)
  supersededBy OperationalReview? @relation("OperationalReviewSupersession")
  auditEvents OperationalReviewAuditEvent[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([buildingId])
  @@index([populationOperationalEventId])
  @@index([incidentEventId])
  @@index([exerciseReportId])
  @@index([status])
}

model OperationalReviewAuditEvent {
  id String @id @default(uuid())
  reviewId String
  review OperationalReview @relation(fields: [reviewId], references: [id], onDelete: Restrict)
  type OperationalReviewAuditEventType
  actorType CoroActorType
  actorId String
  metadata Json?
  createdAt DateTime @default(now())

  @@index([reviewId, createdAt])
}

model VisitorInvitation {
  id             String   @id @default(uuid())
  buildingId     String
  building       Building @relation(fields: [buildingId], references: [id])
  firstName      String
  lastName       String
  email          String
  company        String?
  reason         String?
  hostName       String?
  visitDate      DateTime
  qrToken        String   @unique @default(uuid())
  status         String   @default("PENDING") // PENDING | USED | EXPIRED
  invitedById    String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TrustedDevice {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model ClientTrustedDevice {
  id        String     @id @default(uuid())
  token     String     @unique
  userId    String
  user      ClientUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime   @default(now())
}

model Referral {
  id String @id @default(uuid())

  // Organisation qui recommande CORO
  referrerOrganizationId String
  referrerOrganization   Organization @relation("ReferralReferrer", fields: [referrerOrganizationId], references: [id])

  // Organisation recommandée, une fois le compte créé
  referredOrganizationId String?       @unique
  referredOrganization   Organization? @relation("ReferralReferred", fields: [referredOrganizationId], references: [id])

  // Utilisateur à l'origine de la recommandation
  createdByUserId String?
  createdByUser   User?   @relation("ReferralCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  // Code utilisé au moment de la recommandation
  referralCode String

  // Informations prospect
  prospectCompanyName String?
  prospectFirstName   String?
  prospectLastName    String?
  prospectEmail       String?
  prospectPhone       String?

  // Origine
  source ReferralSource @default(LINK)

  // Cycle de vie
  status ReferralStatus @default(PENDING)

  // Attribution
  firstTouchAt DateTime  @default(now())
  expiresAt    DateTime?

  registeredAt DateTime?
  qualifiedAt  DateTime?
  convertedAt  DateTime?
  rewardedAt   DateTime?
  rejectedAt   DateTime?
  cancelledAt  DateTime?

  // Valeur commerciale au moment de la conversion
  conversionValueCents Int?
  currency             String @default("CAD")

  // Récompense prévue
  rewardAmountCents Int @default(25000)

  // Administration
  adminNotes      String?
  rejectionReason String?

  // Informations complémentaires
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  credits ReferralCredit[]

  @@index([referrerOrganizationId])
  @@index([createdByUserId])
  @@index([prospectEmail])
  @@index([referralCode])
  @@index([status])
  @@index([createdAt])
}

model ReferralCredit {
  id String @id @default(uuid())

  organizationId String
  organization   Organization @relation("ReferralCreditOrganization", fields: [organizationId], references: [id])

  referralId String?
  referral   Referral? @relation(fields: [referralId], references: [id], onDelete: SetNull)

  type   ReferralCreditType
  status ReferralCreditStatus @default(PENDING)

  // Montant signé en cents
  // +25000 = crédit de 250 $
  // -25000 = utilisation ou annulation de 250 $
  amountCents Int

  currency String @default("CAD")

  description String?
  adminNotes  String?

  approvedAt DateTime?
  appliedAt  DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([referralId])
  @@index([status])
  @@index([createdAt])
}
