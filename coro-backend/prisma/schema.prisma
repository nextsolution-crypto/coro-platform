model RueFacilityProfile {
  id String @id @default(uuid())

  // Une installation ne possède qu'un seul profil RUE opérationnel.
  buildingId String   @unique
  building   Building @relation(fields: [buildingId], references: [id], onDelete: Restrict)

  // État de l'évaluation réglementaire.
  // CORO ne doit pas déduire qu'un site est juridiquement assujetti
  // simplement parce qu'il s'agit d'un bâtiment industriel.
  assessmentStatus RueAssessmentStatus @default(NOT_ASSESSED)

  // Provenance de l'état actuellement enregistré.
  assessmentSource RueDataSource @default(MANUAL)

  // Traçabilité de la détermination.
  assessedAt      DateTime?
  assessedByType  CoroActorType?
  assessedById    String?
  assessmentNotes String?

  // Référence réglementaire/documentaire utilisée lors de l'évaluation.
  // Ex. version du RUE, analyse externe ou référence au futur PUE.
  assessmentReference String?

  // Activation fonctionnelle.
  // Un site peut être confirmé assujetti sans que Sentinelle Population
  // soit encore configuré ou activé.
  populationEnabled Boolean @default(false)

  // Préparation du futur configurateur PUE.
  // Permet de rattacher le profil au projet PUE qui l'exploite sans faire
  // du document PUE le propriétaire des données opérationnelles.
  pueProjectId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Substances réglementées réellement présentes ou prévues sur ce site.
  substances RueFacilitySubstance[]

  // Scénarios d'urgence environnementale propres à cette installation.
  emergencyScenarios RueEmergencyScenario[]

  // Éléments humains, bâtis, naturels et infrastructurels présents
  // dans les environs susceptibles d'être touchés.
  surroundingAssets RueSurroundingAsset[]

  // Autorités locales, services d'urgence et organismes externes
  // concernés par la planification ou l'intervention.
  localAuthorities RueLocalAuthority[]

  // Programme opérationnel Sentinelle Population associé au profil.
  populationProgram PopulationProgram?

  @@index([assessmentStatus])
  @@index([populationEnabled])
  @@index([pueProjectId])
}

// ─── CORO SENTINELLE POPULATION ─────────────────────────────────────────────
//
// Couche opérationnelle de communication avec la population.
// Les données réglementaires RUE/PUE restent dans RueFacilityProfile
// et ses modèles associés.

model PopulationProgram {
  id String @id @default(uuid())

  // Un seul programme opérationnel par profil RUE.
  // Le bâtiment propriétaire du programme est déterminé par
  // RueFacilityProfile.buildingId afin d'éviter toute incohérence
  // entre le programme Population et son installation.
  rueFacilityProfileId String             @unique
  rueFacilityProfile   RueFacilityProfile @relation(fields: [rueFacilityProfileId], references: [id], onDelete: Restrict)

  status         PopulationProgramStatus  @default(NOT_CONFIGURED)
  deliveryMode   PopulationDeliveryMode   @default(SANDBOX)
  governanceMode PopulationGovernanceMode @default(STANDARD)

  // ── Portail public ──────────────────────────────────────────────────────

  // Identifiant public stable et lisible.
  // Exemple : sobeys-boucherville
  publicSlug String @unique

  nameFR String
  nameEN String?

  descriptionFR String?
  descriptionEN String?

  // Coordonnées publiques de l'organisation responsable du programme.
  publicPhone String?
  publicEmail String?
  websiteUrl  String?

  // ── Inscription publique ────────────────────────────────────────────────

  registrationEnabled Boolean @default(false)

  // Canaux pouvant être proposés aux citoyens.
  smsEnabled   Boolean @default(true)
  emailEnabled Boolean @default(true)

  // ── Information relative à la vie privée ───────────────────────────────

  privacyTextFR String?
  privacyTextEN String?

  consentTextFR String?
  consentTextEN String?

  // Version permettant de savoir quel texte était applicable
  // lorsqu'un consentement a été recueilli.
  consentVersion String?

  // ── Exploitation ────────────────────────────────────────────────────────

  activatedAt DateTime?
  suspendedAt DateTime?
  archivedAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscribers       PopulationSubscriber[]
  consentEvents     PopulationConsentEvent[]
  smsConsentEvidence PopulationSmsConsentEvidence[]
  alerts            PopulationAlert[]
  operationalEvents PopulationOperationalEvent[]
  evidenceRecords   PopulationEvidenceRecord[]
  evidenceManifests PopulationEvidenceManifest[]
  evidenceReports   PopulationEvidenceReport[]

  @@index([status])
  @@index([registrationEnabled])
}

model PopulationSubscriber {
  id String @id @default(uuid())

  programId String
  program   PopulationProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  status      PopulationSubscriberStatus @default(PENDING_VERIFICATION)
  isSynthetic Boolean                    @default(false)

  // Langue utilisée pour les communications d'urgence.
  preferredLanguage PopulationPreferredLanguage @default(FR)

  // ── Coordonnées minimales ──────────────────────────────────────────────

  // Le nom n'est pas nécessaire au ciblage géographique ni à l'envoi
  // d'une alerte. Il reste donc facultatif.
  firstName String?
  lastName  String?

  phone          String?
  phoneCanonical String?
  email          String?

  smsEnabled   Boolean @default(false)
  emailEnabled Boolean @default(false)

  // ── Position opérationnelle ────────────────────────────────────────────
  //
  // L'adresse saisie lors de l'inscription peut servir au géocodage.
  // L'objectif est de ne pas conserver l'adresse résidentielle complète
  // lorsque la position obtenue suffit au ciblage des zones d'impact.

  latitude  Float?
  longitude Float?

  // Permet de savoir comment la position a été obtenue sans conserver
  // nécessairement l'adresse source.
  locationSource String?

  locationResolvedAt DateTime?

  // ── Cycle de vie ───────────────────────────────────────────────────────

  verifiedAt     DateTime?
  unsubscribedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  consentEvents   PopulationConsentEvent[]
  smsConsentEvidence PopulationSmsConsentEvidence[]
  verifications   PopulationVerification[]
  alertDeliveries PopulationAlertDelivery[]

  @@index([programId])
  @@index([status])
  @@index([programId, status])
  @@index([phone])
  @@index([programId, phoneCanonical])
  @@index([email])
}

model PopulationConsentEvent {
  id        String            @id @default(uuid())
  programId String
  program   PopulationProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  // Référence vers l'abonné lorsqu'il existe encore.
  // La suppression ultérieure des renseignements personnels de l'abonné
  // ne doit pas supprimer automatiquement la preuve historique de consentement.
  subscriberId String?
  subscriber   PopulationSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  type PopulationConsentEventType

  // Version du texte présenté au moment de l'événement.
  consentVersion String

  // Canaux auxquels le consentement s'appliquait.
  smsEnabled   Boolean
  emailEnabled Boolean

  // Source de l'action.
  // Ex. PUBLIC_PORTAL, CLIENT_PORTAL, IMPORT.
  source String?

  occurredAt DateTime @default(now())

  @@index([programId])
  @@index([subscriberId])
  @@index([type])
  @@index([occurredAt])
}

model PopulationSmsConsentEvidence {
  id String @id @default(uuid())

  programId String
  program   PopulationProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  subscriberId String
  subscriber   PopulationSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Restrict)

  consentVersion     String
  language           PopulationPreferredLanguage
  disclosureSnapshot String
  source             String
  surface            String
  smsEnabled         Boolean
  emailEnabled       Boolean
  submittedAt        DateTime
  verifiedAt         DateTime?
  createdAt          DateTime @default(now())

  @@index([programId])
  @@index([subscriberId])
  @@index([submittedAt])
  @@index([verifiedAt])
}

model PopulationVerification {
  id String @id @default(uuid())

  subscriberId String
  subscriber   PopulationSubscriber @relation(fields: [subscriberId], references: [id], onDelete: Cascade)

  channel PopulationVerificationChannel

  // Le code OTP n'est jamais conservé en clair.
  codeHash String

  expiresAt DateTime

  attemptCount Int @default(0)
  maxAttempts  Int @default(5)

  verifiedAt DateTime?

  createdAt DateTime @default(now())

  @@index([subscriberId])
  @@index([expiresAt])
}

model PopulationAlert {
  id String @id @default(uuid())

  programId String
  program   PopulationProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  // Une alerte publique peut être rattachée à un incident CORO existant.
  // Elle peut également exister sans incident réel dans le cas d'un test.
  incidentEventId String?
  incidentEvent   IncidentEvent? @relation(fields: [incidentEventId], references: [id], onDelete: SetNull)

  // Scénario RUE/PUE ayant servi de contexte à l'alerte.
  // Facultatif notamment pour certains tests ou messages indépendants.
  // La suppression ultérieure du scénario ne détruit pas l'alerte.
  emergencyScenarioId String?
  emergencyScenario   RueEmergencyScenario? @relation(fields: [emergencyScenarioId], references: [id], onDelete: SetNull)

  // Agrégat opérationnel parent. Nullable afin que toutes les
  // communications historiques restent valides sans rattachement spéculatif.
  operationalEventId String?
  operationalEvent   PopulationOperationalEvent? @relation(fields: [operationalEventId], references: [id], onDelete: Restrict)

  // Ordre de la communication dans son événement. L'attribution
  // transactionnelle sera prise en charge par le workflow opérationnel.
  cycleSequence Int?

  // UUID fourni par le client pour identifier une intention de création.
  // Une réponse HTTP perdue peut ainsi être rejouée sans créer une seconde
  // communication dans le même événement opérationnel.
  clientIntentId String?

  type   PopulationAlertType
  status PopulationAlertStatus @default(DRAFT)

  // ── Message diffusé ────────────────────────────────────────────────────

  titleFR String
  titleEN String?

  messageFR String
  messageEN String?

  instructionFR String?
  instructionEN String?

  // ── Validation humaine ─────────────────────────────────────────────────

  createdByType CoroActorType
  createdById   String

  approvedByType CoroActorType?
  approvedById   String?
  approvedAt     DateTime?

  readyByType CoroActorType?
  readyById   String?
  readyAt     DateTime?

  frozenByType CoroActorType?
  frozenById   String?

  sentByType CoroActorType?
  sentById   String?

  cancelledByType CoroActorType?
  cancelledById   String?

  endedByType CoroActorType?
  endedById   String?

  // ── Cycle de vie ───────────────────────────────────────────────────────

  scheduledAt          DateTime?
  recipientsFrozenAt   DateTime?
  deliveryModeSnapshot PopulationDeliveryMode?
  sendingAt            DateTime?
  activatedAt          DateTime?
  endedAt              DateTime?
  cancelledAt          DateTime?

  // ── Preuve / snapshot ──────────────────────────────────────────────────
  //
  // Conserve le contexte opérationnel utilisé lors de la diffusion.
  // Les modifications futures du PUE ou du profil RUE ne doivent pas
  // réécrire l'histoire de cette alerte.

  contextSnapshot Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  zones      PopulationAlertZone[]
  deliveries PopulationAlertDelivery[]

  @@unique([operationalEventId, cycleSequence])
  @@unique([operationalEventId, clientIntentId])
  @@index([programId])
  @@index([incidentEventId])
  @@index([emergencyScenarioId])
  @@index([operationalEventId])
  @@index([status])
  @@index([type])
  @@index([createdAt])
}

model PopulationAlertZone {
  id String @id @default(uuid())

  alertId String
  alert   PopulationAlert @relation(fields: [alertId], references: [id], onDelete: Restrict)

  // Référence vers une zone RUE/PUE préconfigurée lorsqu'elle existe.
  //
  // Cette relation est facultative pour deux raisons :
  // 1. une zone source peut être retirée ultérieurement;
  // 2. une alerte peut utiliser une zone opérationnelle dynamique calculée
  //    pendant l'incident, sans RueImpactZone préexistante.
  //
  // Dans tous les cas, les champs *Snapshot ci-dessous constituent
  // l'état historique de la zone réellement utilisée.
  impactZoneId String?
  impactZone   RueImpactZone? @relation(fields: [impactZoneId], references: [id], onDelete: SetNull)

  // Snapshot de la zone utilisée lors de l'alerte.
  zoneCodeSnapshot   String
  zoneNameFRSnapshot String
  zoneNameENSnapshot String?

  geometrySnapshot         Json?
  maxDistanceKmSnapshot    Float?
  protectiveActionSnapshot RueProtectiveAction?

  instructionFRSnapshot String?
  instructionENSnapshot String?

  // Nombre d'abonnés déterminés comme étant dans cette zone
  // au moment où le ciblage a été figé.
  targetedSubscriberCount Int @default(0)

  createdAt DateTime @default(now())

  @@unique([alertId, zoneCodeSnapshot])
  @@index([alertId])
  @@index([impactZoneId])
}

model PopulationAlertDelivery {
  id String @id @default(uuid())

  // Clé technique générée par CORO avant l'envoi.
  // Une même opération logique d'envoi ne peut être créée qu'une seule fois,
  // même en cas de retry HTTP, double clic ou concurrence entre workers.
  idempotencyKey String @unique

  alertId String
  alert   PopulationAlert @relation(fields: [alertId], references: [id], onDelete: Restrict)

  subscriberId String?
  subscriber   PopulationSubscriber? @relation(fields: [subscriberId], references: [id], onDelete: SetNull)

  channel           PopulationAlertChannel
  status            PopulationDeliveryStatus             @default(QUEUED)
  suppressionReason PopulationDeliverySuppressionReason?

  // Langue réellement utilisée pour cette transmission.
  language PopulationPreferredLanguage

  // Message réellement transmis.
  //
  // Important pour préserver la preuve si le brouillon de l'alerte
  // est ultérieurement modifié.
  messageSnapshot String

  // Destination protégée/minimisée utilisée au moment de l'envoi.
  // La stratégie exacte de protection sera définie côté service.
  destinationSnapshot String?

  // Identifiant retourné par Brevo/Twilio/autre fournisseur.
  providerMessageId String?

  provider String?

  // UUID stable transmis au fournisseur pour dédupliquer les reprises.
  providerIdempotencyKey String? @unique

  // État de la tentative courante et planification des reprises confirmées.
  attemptCount          Int       @default(0)
  lastAttemptAt         DateTime?
  nextAttemptAt         DateTime?
  claimedAt             DateTime?
  leaseExpiresAt        DateTime?
  outcomeUnknownAt      DateTime?
  // Frontière persistée juste avant l'appel réseau fournisseur. Une lease
  // expirée sans cette valeur est rejouable; avec cette valeur elle doit être
  // réconciliée, jamais renvoyée aveuglément.
  providerCallStartedAt DateTime?

  queuedAt    DateTime  @default(now())
  sentAt      DateTime?
  deliveredAt DateTime?
  failedAt    DateTime?
  cancelledAt DateTime?

  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerEvents PopulationDeliveryProviderEvent[]

  @@index([alertId])
  @@index([subscriberId])
  @@index([status])
  @@index([providerMessageId])
  @@index([status, nextAttemptAt])
  @@index([status, leaseExpiresAt])
}

model PopulationDeliveryProviderEvent {
  id String @id @default(uuid())

  deliveryId String
  delivery   PopulationAlertDelivery @relation(fields: [deliveryId], references: [id], onDelete: Restrict)

  provider           String
  providerMessageId  String
  eventType          PopulationDeliveryProviderEventType
  providerOccurredAt DateTime
  receivedAt         DateTime                            @default(now())

  // Empreintes SHA-256 de valeurs techniques minimales. Aucun payload brut,
  // contenu de message ou destination citoyenne n'est conservé ici.
  eventFingerprint   String @unique
  payloadFingerprint String

  @@index([deliveryId])
  @@index([providerMessageId])
  @@index([eventType])
  @@index([providerOccurredAt])
}

enum PopulationDeliveryProviderEventType {
  ACCEPTED
  DELIVERED
  DEFERRED
  SOFT_BOUNCE
  HARD_BOUNCE
  BLOCKED
  INVALID
  ERROR
  SPAM
  UNSUBSCRIBED
}

