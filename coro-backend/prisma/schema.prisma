  // Montant signé en cents
  // +25000 = crédit de 250 $
  // -25000 = utilisation ou annulation de 250 $
  amountCents Int

  currency String @default("CAD")

  description String?
  adminNotes  String?

  approvedAt DateTime?
  appliedAt  DateTime?
  expiresAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([referralId])
  @@index([status])
  @@index([createdAt])
}

model MeteringResult {
  id String @id @default(uuid())

  organizationId String
  clientId       String?
  buildingId     String?

  capabilityCode CapabilityCode
