  PREPAREDNESS
  RESPONSE
  RECOVERY
}

enum PopulationSubscriberStatus {
  PENDING_VERIFICATION
  ACTIVE
  UNSUBSCRIBED
  SUSPENDED
}

enum PopulationPreferredLanguage {
  FR
  EN
}

enum PopulationConsentEventType {
  SUBSCRIBED
  VERIFIED
  CONSENT_UPDATED
  UNSUBSCRIBED
}

enum PopulationVerificationChannel {
  SMS
  EMAIL
}

enum PopulationProgramStatus {
  NOT_CONFIGURED
  CONFIGURING
  READY
  ACTIVE
  SUSPENDED
  ARCHIVED
}

// Le statut d'un événement est distinct du statut d'une communication.
// PopulationAlert.ACTIVE signifie qu'une communication a été acceptée ou
// livrée; ACTIVE ci-dessous signifie que la situation opérationnelle perdure.
enum PopulationOperationalEventStatus {
  ACTIVE
  ENDED
  CANCELLED
}

enum PopulationAlertType {
  TEST
  PRE_ALERT
  EMERGENCY
  UPDATE
  ALL_CLEAR
}

enum PopulationAlertStatus {
  DRAFT
  READY
  SENDING
  ACTIVE
  ENDED
  CANCELLED
  FAILED
}

enum PopulationAlertChannel {
  SMS
  EMAIL
}

enum PopulationDeliveryStatus {
  QUEUED
  SENDING
