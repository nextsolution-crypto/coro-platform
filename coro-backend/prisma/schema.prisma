// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  isInternal  Boolean  @default(false)
  licenseType String   @default("ESSAI_GRATUIT")
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users              User[]
  clients            Client[]
  buildings          Building[]
  projects           Project[]
  procedureOverrides ProcedureOverride[]
  feedbacks          Feedback[]
  projectTemplates   ProjectTemplate[]
  auditLogs          AuditLog[]
  customProcedures CustomProcedure[]
  clientUsers    ClientUser[]
}

model User {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  firstName      String
  lastName       String
  role           UserRole @default(OPERATOR)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  companyName        String?
  companyLogo        String?
  companyLogoB64     String?
  companyLogoFullB64 String?
  companyPhone       String?
  companyEmail       String?
  companyAddress     String?
  companyWebsite     String?
  companyTagline     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  observationsCreated  ReviewObservation[] @relation("observationCreator")
  observationsTreated  ReviewObservation[] @relation("observationTreater")
  approvedProjects   Project[] @relation("approvedProjects")
  notifications        Notification[]

  projects            Project[]
  feedbacks           Feedback[]
  lastEditedProjects  Project[]             @relation("lastEditedProjects")
  submittedProjects   Project[]             @relation("submittedProjects")
  createdTemplates    ProjectTemplate[]     @relation("createdTemplates")
  auditLogs           AuditLog[]
  taskAssignees       ProjectTaskAssignee[]
  timeEntries         TaskTimeEntry[]
  projectComments     ProjectComment[]
  ownedMandates   ProjectMandate[] @relation("mandateOwner")
  assignedTasks   ProjectTask[]    @relation("taskAssignee")
  horaireBase    Float    @default(40)
  timelogEntries  TimelogEntry[]
  customProcedures CustomProcedure[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  OPERATOR
}

model Client {
  id             String   @id @default(uuid())
  name           String
  contactFirstName  String?
  contactLastName   String?
  contactEmail      String?
  contactPhone      String?
  email          String?
  phone          String?
  address        String?
  city           String?
  province       String?
  logoUrl        String?
  logoBase64     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  buildings Building[]
  projects  Project[]
  clientUsers    ClientUser[]
}

model Building {
  id             String   @id @default(uuid())
  name           String
  address        String
  city           String
  province       String
  postalCode     String?
  floors         Int?
  units          Int?
  buildingType   String?
  photoBase64    String?
  responsableFirstName String?
  responsableLastName  String?
  responsableTitre     String?
  responsableEmail     String?
  responsablePhone     String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId String
  client   Client   @relation(fields: [clientId], references: [id])
  projects Project[]
}

model Project {
  id           String        @id @default(uuid())
  name         String
  documentType DocumentType
  status       ProjectStatus @default(DRAFT)
  year         Int
  progress     Int           @default(0)
  configData   Json?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  observations   ReviewObservation[]

  lastEditedById String?
  lastEditedBy   User?  @relation("lastEditedProjects", fields: [lastEditedById], references: [id])
  submittedById  String?
  submittedAt    DateTime?
  submittedBy    User?  @relation("submittedProjects", fields: [submittedById], references: [id])
  approvedById   String?
  approvedAt     DateTime?
  approvedBy     User?  @relation("approvedProjects", fields: [approvedById], references: [id])
  exportedPdfFr  String?
  exportedPdfEn  String?
  officialPdfFr  String?
  officialPdfEn  String?
  exportedAt     DateTime?

  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  clientId   String
  client     Client   @relation(fields: [clientId], references: [id])
  buildingId String
  building   Building @relation(fields: [buildingId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])

  documents          Document[]
  buildingPlans      BuildingPlan[]
  module7            Module7Data?
  revisionHistory    RevisionHistory[]
  procedureOverrides ProcedureOverride[]
  projectVersions    ProjectVersion[]
  activities         ProjectActivity[]
  projectTasks       ProjectTask[]
  mandate            ProjectMandate?
  comments           ProjectComment[]

  projectTaskLists ProjectTaskList[]
  customProcedures CustomProcedure[]
  signatures     DocumentSignature[]
}

model RevisionHistory {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  date        String
  description String
  responsable String
  createdAt   DateTime @default(now())
}

enum DocumentType {
  PSI
  PMU
  PCA
  PGC
  PRA
  PUE
}

enum ProjectStatus {
  DRAFT
  IN_PROGRESS
  REVIEW
  VALIDATED
  EXPORTED
  ARCHIVED
}

model Document {
  id        String         @id @default(uuid())
  title     String
  content   Json?
  status    DocumentStatus @default(DRAFT)
  version   Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  projectId String
  project   Project @relation(fields: [projectId], references: [id])
}

enum DocumentStatus {
  DRAFT
  IN_PROGRESS
  VALIDATED
  EXPORTED
  ARCHIVED
}

model IncidentCode {
  id          String   @id @default(uuid())
  code        String   @unique
  name        String
  color       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  procedures Procedure[]
}

model Role {
  id          String   @id @default(uuid())
  name        String
  roleCode    String   @unique
  description String?
  isStandard  Boolean  @default(true)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  procedures Procedure[]
}

model Procedure {
  id            String          @id @default(uuid())
  name          String
  description   String?
  documentTypes String[]
  phase         String?
  status        ProcedureStatus @default(DRAFT)
  content       Json?
  version       Int             @default(1)
  isActive      Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  incidentCodeId String?
  incidentCode   IncidentCode? @relation(fields: [incidentCodeId], references: [id])
  roleId         String?
  role           Role?         @relation(fields: [roleId], references: [id])
}

enum ProcedureStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

model LibrarySection {
  id            String   @id @default(uuid())
  title         String
  documentTypes String[]
  order         Int      @default(0)
  content       Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BuildingPlan {
  id           String      @id @default(uuid())
  projectId    String
  project      Project     @relation(fields: [projectId], references: [id])
  section      PlanSection
  name         String
  description  String?
  fileBase64   String
  fileName     String
  fileSize     Int
  emissionDate String?
  revision     String?
  order        Int         @default(0)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

enum PlanSection {
  IMPLANTATION
  COUPE
  OPERATION
  SECTEURS
  DIVERS
}

model Module7Data {
  id        String  @id @default(uuid())
  projectId String  @unique
  project   Project @relation(fields: [projectId], references: [id])

  quartsData Json?
  photosData Json?
  extraData  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChangelogEntry {
  id          String   @id @default(uuid())
  title       String
  description String
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())
}

model ProcedureDefault {
  id        String   @id @default(uuid())
  code      String   @unique
  content   Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  overrides ProcedureOverride[]
}

model ProcedureOverride {
  id             String   @id @default(uuid())
  procedureId    String
  organizationId String
  projectId      String?
  content        Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  procedure    ProcedureDefault @relation(fields: [procedureId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id])
  project      Project?         @relation(fields: [projectId], references: [id])

  @@unique([procedureId, organizationId, projectId])
}

model Feedback {
  id             String   @id @default(uuid())
  category       String
  message        String
  status         String   @default("NOUVEAU")
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

model ProjectVersion {
  id            String   @id @default(uuid())
  projectId     String
  versionNumber Int
  label         String?
  snapshot      Json
  createdAt     DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id])
}

model ProjectTemplate {
  id             String   @id @default(uuid())
  name           String
  description    String?
  documentType   String
  configData     Json?
  organizationId String
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  createdBy    User         @relation("createdTemplates", fields: [createdById], references: [id])
}

model AuditLog {
  id             String   @id @default(uuid())
  action         String
  entityType     String
  entityId       String
  projectId      String?
  description    String
  metadata       Json?
  userId         String
  organizationId String
  createdAt      DateTime @default(now())

  user         User         @relation(fields: [userId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id])
}

model ProjectActivity {
  id             String    @id @default(uuid())
  projectId      String
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  type           String
  label          String
  duration       String
  mode           String    @default("presentiel")
  customLabel    String?
  customDuration String?
  scheduledDate  DateTime?
  status         String    @default("a_faire")
  reportedDate   DateTime?
  assigneeEmail  String?
  clientEmail    String?
  notes          String?
  organizationId String
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  isRecurring    Boolean  @default(false)
  sourceMandate  Boolean  @default(false)
  dureeHeures    Float?   // Durée réelle ou estimée en heures
}

model TaskList {
  id             String   @id @default(uuid())
  name           String
  description    String?
  category       String   @default("DOCUMENT")
  documentTypes  String[]
  organizationId String?
  isActive       Boolean  @default(true)
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  templates        TaskTemplate[]
  projectTaskLists ProjectTaskList[]
}

model TaskTemplate {
  id             String   @id @default(uuid())
  taskListId     String?
  taskList       TaskList? @relation(fields: [taskListId], references: [id])
  categoryName   String
  taskTitle      String
  documentTypes  String[]
  order          Int      @default(0)
  isActive       Boolean  @default(true)
  organizationId String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  projectTasks ProjectTask[]
}

model ProjectTaskList {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskListId     String
  taskList       TaskList @relation(fields: [taskListId], references: [id])
  customName     String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  tasks ProjectTask[]
}

model ProjectTask {
  id             String        @id @default(uuid())
  projectId      String
  project        Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  templateId     String?
  template       TaskTemplate? @relation(fields: [templateId], references: [id])
  projectTaskListId String?
  projectTaskList   ProjectTaskList? @relation(fields: [projectTaskListId], references: [id])
  categoryName   String
  taskTitle      String
  status         String        @default("a_faire")
  dueDate        DateTime?
  order          Int           @default(0)
  organizationId String
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  assigneeId     String?
  assignee       User?    @relation("taskAssignee", fields: [assigneeId], references: [id])

  timeEntries TaskTimeEntry[]
  assignees   ProjectTaskAssignee[]
}

model ProjectTaskAssignee {
  id        String      @id @default(uuid())
  taskId    String
  task      ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User        @relation(fields: [userId], references: [id])
  createdAt DateTime    @default(now())

  @@unique([taskId, userId])
}

model TaskTimeEntry {
  id             String      @id @default(uuid())
  taskId         String
  task           ProjectTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId         String
  user           User        @relation(fields: [userId], references: [id])
  date           DateTime
  heures         Float
  note           String?
  organizationId String
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model ProjectMandate {
  id              String   @id @default(uuid())
  projectId       String   @unique
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description     String?
  montantVendu    Float?
  tauxHoraire     Float?
  heuresBudgetees Float?
  lienDrive       String?
  organizationId  String
  ownerId         String?
  owner           User?    @relation("mandateOwner", fields: [ownerId], references: [id])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  typeMandat     String?
  dateDebutDelai DateTime?
  dateLimite     DateTime?
  delaiJours     Int?
  alerteActive   Boolean   @default(true)
  typeDelai      String?
}

model ProjectComment {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  contenu        String
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TimelogEntry {
  id             String   @id @default(uuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  organizationId String
  date           DateTime
  heures         Float
  category       String
  note           String?
  isBillable     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TimelogCategory {
  id             String   @id @default(uuid())
  key            String
  label          String
  organizationId String?
  isActive       Boolean  @default(true)
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([key, organizationId])
}

model DangerousSubstance {
  id            String   @id @default(cuid())
  unNumber      String   // Ex: "1202"
  nameFR        String   // Ex: "Diesel"
  nameEN        String   // Ex: "Diesel fuel"
  casNumber     String?  // Ex: "68334-30-5"
  tmdClass      String   // Ex: "3"
  tmdClassLabel String   // Ex: "Liquides inflammables"
  packingGroup  String?  // Ex: "III"
  simdutClass   String?  // Ex: "B3"
  simdutLabel   String?  // Ex: "Liquide combustible"
  placardCode   String   // Ex: "3" (pour le placard SVG)
  keywords      String[] // Ex: ["diesel", "carburant", "mazout"]
  isCommon      Boolean  @default(false) // substances fréquentes en industrie QC
  createdAt     DateTime @default(now())

  @@index([unNumber])
  @@index([nameFR])
}

model CustomProcedure {
  id             String   @id @default(cuid())
  organizationId String
  projectId      String?  // null = disponible pour tous les projets de l'org
  code           String   // Ex: "CP001"
  titleFR        String
  titleEN        String
  objective      String?
  color          String   @default("#2C3E50")
  status         String   @default("DRAFT") // DRAFT | ACTIVE | ARCHIVED
  content        Json     // Structure complète de la procédure
  sourceText     String?  // Texte original saisi par l'utilisateur
  isPublished    Boolean  @default(false) // Disponible pour autres projets
  rolesDetected  String[] // Rôles détectés par l'IA
  createdById    String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization @relation(fields: [organizationId], references: [id])
  project        Project?     @relation(fields: [projectId], references: [id])
  createdBy      User         @relation(fields: [createdById], references: [id])

  @@index([organizationId])
  @@index([projectId])
}

model ReviewObservation {
  id             String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  module         String?
  texte          String
  statut         String   @default("OUVERTE")
  createdById    String
  createdBy      User     @relation("observationCreator", fields: [createdById], references: [id])
  treatedById    String?
  treatedBy      User?    @relation("observationTreater", fields: [treatedById], references: [id])
  organizationId String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Notification {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  organizationId String
  type           String
  title          String
  message        String
  projectId      String?
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model ClientUser {
  id             String   @id @default(uuid())
  email          String   @unique
  password       String
  firstName      String
  lastName       String
  role           ClientUserRole @default(CLIENT_MANAGER)
  buildingIds    String[]
  isActive       Boolean  @default(true)
  clientId       String
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  signatures     DocumentSignature[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model DocumentSignature {
  id            String   @id @default(uuid())
  projectId     String
  project       Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  clientUserId  String
  clientUser    ClientUser @relation(fields: [clientUserId], references: [id], onDelete: Cascade)
  fullName      String
  email         String
  signedAt      DateTime @default(now())
  ipAddress     String?
  comment       String?
}

enum ClientUserRole {
  CLIENT_MANAGER
  CLIENT_CORPORATE
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  titleFr         String
  titleEn         String
  excerptFr       String?
  excerptEn       String?
  contentFr       String    @db.Text
  contentEn       String    @db.Text
  coverImage      String?   @db.Text
  category        String?
  tags            String[]
  authorName      String    @default("Équipe CORO")
  authorTitle     String    @default("Experts en conformité")
  seoTitleFr      String?
  seoTitleEn      String?
  seoDescFr       String?
  seoDescEn       String?
  isPublished     Boolean   @default(false)
  publishedAt     DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}