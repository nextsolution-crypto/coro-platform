[Unit]
Description=CORO isolated monthly remote restore drill
After=docker.service
Requires=docker.service
ConditionPathExists=/etc/coro-backup/restore.env
OnFailure=coro-backup-alert@%n.service

[Service]
Type=oneshot
EnvironmentFile=/etc/coro-backup/backup.env
EnvironmentFile=/etc/coro-backup/spaces.env
EnvironmentFile=/etc/coro-backup/restore.env
ExecStart=/opt/coro-ops/backup/coro-db-restore-run.sh
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/etc/coro-backup /opt/coro-ops/backup /opt/coro-ops/backups/database
ReadWritePaths=/opt/coro-ops/restore-drills
RestrictSUIDSGID=true
LockPersonality=true
