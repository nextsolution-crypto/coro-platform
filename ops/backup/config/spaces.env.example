# Install as /etc/coro-backup/spaces.env with root:root 0600.
CORO_BACKUP_SPACES_ENDPOINT=https://tor1.digitaloceanspaces.com
CORO_BACKUP_SPACES_REGION=tor1
CORO_BACKUP_SPACES_BUCKET=REPLACE_WITH_PRIVATE_BUCKET
CORO_BACKUP_SPACES_PREFIX=database-backups/production/
CORO_BACKUP_SPACES_ACCESS_KEY=REPLACE_WITH_DEDICATED_ACCESS_KEY
CORO_BACKUP_SPACES_SECRET_KEY=REPLACE_WITH_DEDICATED_SECRET_KEY
