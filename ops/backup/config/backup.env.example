CORO_BACKUP_ENVIRONMENT=production
CORO_BACKUP_DIR=/opt/coro-ops/backups/database
CORO_BACKUP_DATABASE=coro_db
CORO_BACKUP_POSTGRES_CONTAINER=coro_postgres
CORO_BACKUP_POSTGRES_USER=coro_user
CORO_BACKUP_LOCK_PATH=/opt/coro-ops/backups/database/.coro-db-backup.lock
CORO_BACKUP_STATE_PATH=/opt/coro-ops/backups/database/backup-state.json
CORO_BACKUP_REMOTE_ENABLED=true
CORO_RESTORE_WORKSPACE=/opt/coro-ops/restore-drills
