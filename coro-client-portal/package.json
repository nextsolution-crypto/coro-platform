{
  "name": "coro-client-portal",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev -p 3003",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test:skin": "node design-system/portal-glass.test.cjs && node app/components/active-navigation.test.cjs && node app/buildings/building-projects.test.cjs",
    "test:sms-compliance": "node --experimental-strip-types app/population/lib/smsCompliance.test.ts",
    "test:sentinelle-auth": "node app/sentinelle/sentinelleAuth.contract.test.mjs",
    "test:incident-history": "node --experimental-strip-types \"app/sentinelle/[buildingId]/incidents/incidentHistoryState.test.ts\"",
    "test:population-sharing": "node \"app/sentinelle/[buildingId]/population/publicPortalSharing.test.mjs\"",
    "test:population-identity": "node app/population/populationIdentity.contract.test.mjs",
    "test:population-profile": "node app/population/populationContactProfile.contract.test.mjs",
    "test:bookings": "node app/bookings/bookings.contract.test.mjs",
    "test:offline-documents": "node app/offline-documents/offline-security.contract.test.mjs"
  },
  "dependencies": {
    "html5-qrcode": "^2.3.8",
    "lucide-react": "^1.31.0",
    "next": "^16.4.2",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
